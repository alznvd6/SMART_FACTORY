void printLocalConsole(void)
{
    char uiBuffer[250];

    // Using simple newlines (\r\n) keeps the Proteus window printing cleanly
    // without scrambling text fragments over each other.
    snprintf(uiBuffer, sizeof(uiBuffer),
             "\r\n=================================\r\n"
             "   BOARD #2 (CONTROLLER) LOG\r\n"
             "=================================\r\n"
             " * Remote ADC (Board 1) : %s\r\n"
             " * Message from Board 1 : %s\r\n"
             " * Last Typed Command   : [%s]\r\n"
             "=================================\r\n",
             sharedAdcValue, messageFromBoard1, rxBuffer);

    HAL_UART_Transmit(&huart2, (uint8_t*)uiBuffer, strlen(uiBuffer), 100);
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    // Handle Background Inter-Board Protocol (USART1)
    if (huart->Instance == USART1)
    {
        static char mcuBuffer[50];
        static uint8_t mcuIndex = 0;

        if (rxByte1 == '\r' || rxByte1 == '\n')
        {
            if (mcuIndex > 0)
            {
                mcuBuffer[mcuIndex] = '\0';
                if (mcuBuffer[0] == '@')
                {
                    strncpy(messageFromBoard1, &mcuBuffer[1], sizeof(messageFromBoard1) - 1);
                    printLocalConsole();
                }
                else if (strncmp(mcuBuffer, "ADC=", 4) == 0)
                {
                    strncpy(sharedAdcValue, &mcuBuffer[4], sizeof(sharedAdcValue) - 1);
                    printLocalConsole();
                }
                mcuIndex = 0;
                memset(mcuBuffer, 0, sizeof(mcuBuffer));
            }
        }
        else if (mcuIndex < sizeof(mcuBuffer) - 1)
        {
            mcuBuffer[mcuIndex++] = (char)rxByte1;
        }
        HAL_UART_Receive_IT(&huart1, &rxByte1, 1);
    }

    // Handle Keyboard Terminal Interactions (USART2)
    if (huart->Instance == USART2)
    {
        if (rxByte2 == '\r' || rxByte2 == '\n')
        {
            if (rxIndex > 0)
            {
                rxBuffer[rxIndex] = '\0';
                lineReadyFromTerminal = 1;
            }
        }
        else if (rxIndex < sizeof(rxBuffer) - 1)
        {
            // Echo back to user window instantly
            HAL_UART_Transmit(&huart2, &rxByte2, 1, 10);
            rxBuffer[rxIndex++] = (char)rxByte2;
        }
        HAL_UART_Receive_IT(&huart2, &rxByte2, 1);
    }
}
