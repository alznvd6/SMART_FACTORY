/**
 * @brief Evaluates finalized command entry strings from the console
 */
void HUB_Process_Input(char *input) {
    // Shared escape logic: '0' safely defaults back to main page
    if (strcmp(input, "0") == 0) {
        current_hub_state = HUB_STATE_MAIN_MENU;
        hub_needs_refresh = 1;
        return;
    }

    switch (current_hub_state) {
        case HUB_STATE_MAIN_MENU:
            if (strcmp(input, "1") == 0) {
                current_hub_state = HUB_STATE_MONITOR_VIEW;
            } else if (strcmp(input, "2") == 0) {
                current_hub_state = HUB_STATE_ADMIN_AUTH;
            } else {
                HAL_UART_Transmit(&huart3, (uint8_t*)"\r\nInvalid option!", 17, 100);
                HAL_Delay(800);
            }
            hub_needs_refresh = 1;
            break;

        case HUB_STATE_MONITOR_VIEW:
            hub_needs_refresh = 1;
            break;

        case HUB_STATE_ADMIN_AUTH:
            if (strcmp(input, "2222") == 0) { // Custom Admin Password for Board #2
                current_hub_state = HUB_STATE_ADMIN_MENU;
            } else {
                HAL_UART_Transmit(&huart3, (uint8_t*)"\r\n[ACCESS DENIED] Incorrect!", 28, 100);
                HAL_Delay(1000);
                current_hub_state = HUB_STATE_MAIN_MENU;
            }
            hub_needs_refresh = 1;
            break;

        case HUB_STATE_ADMIN_MENU:
            if (strcmp(input, "clear_logs") == 0) {
                HAL_UART_Transmit(&huart3, (uint8_t*)"\r\n[SUCCESS] Local Hub structures cleared.", 41, 100);
                HAL_Delay(1000);
            } else {
                HAL_UART_Transmit(&huart3, (uint8_t*)"\r\nUnknown Command!", 18, 100);
                HAL_Delay(800);
            }
            hub_needs_refresh = 1;
            break;
    }
}
void Parse_Telemetry(char *packet)
{
    // 1. Basic validation: ensure it's a legitimate telemetry packet starting with '@'
    if (packet == NULL || packet[0] != '@') {
        return;
    }

    // 2. Stream the raw string over USART2 (to COMPIM -> Python) with a newline
    char forward_buf[128];
    int len = snprintf(forward_buf, sizeof(forward_buf), "%s\n", packet);
    if (len > 0 && len < (int)sizeof(forward_buf)) {
        HAL_UART_Transmit(&huart2, (uint8_t*)forward_buf, (uint16_t)len, 100);
    }

    // 3. Local Hardware Parsing: Extract named key-value fields safely
    char *ptr = packet;
    while (ptr != NULL && *ptr != '\0') {
        // Skip any leading delimiter characters
        if (*ptr == '@' || *ptr == '|') {
            ptr++;
            continue;
        }

        // Catch and map the specific keys matched to Board #1's stream format
        if (strncmp(ptr, "CUR=", 4) == 0) {
            ptr += 4;
            int i = 0;
            while (*ptr != '|' && *ptr != '\0' && i < (int)sizeof(remote_temp) - 1) {
                remote_temp[i++] = *ptr++;
            }
            remote_temp[i] = '\0';
        }
        else if (strncmp(ptr, "AVG=", 4) == 0) {
            ptr += 4;
            int i = 0;
            while (*ptr != '|' && *ptr != '\0' && i < (int)sizeof(remote_avg) - 1) {
                remote_avg[i++] = *ptr++;
            }
            remote_avg[i] = '\0';
        }
        else if (strncmp(ptr, "FIRE=", 5) == 0) {
            ptr += 5;
            // Map 1 -> HAZARD, 0 -> CLEAR
            if (*ptr == '1') {
                strncpy(remote_fire, "HAZARD ALERT", sizeof(remote_fire) - 1);
            } else {
                strncpy(remote_fire, "CLEAR", sizeof(remote_fire) - 1);
            }
            // Move pointer past the value
            while (*ptr != '|' && *ptr != '\0') ptr++;
        }
        else if (strncmp(ptr, "LOCK=", 5) == 0) {
            ptr += 5;
            remote_lock[0] = *ptr;
            remote_lock[1] = '\0';
            while (*ptr != '|' && *ptr != '\0') ptr++;
        }
        else {
            // Advance pointer to avoid getting stuck on unknown parameter tags
            while (*ptr != '|' && *ptr != '\0') {
                ptr++;
            }
        }
    }
}
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    // Channel A: Communication incoming from Board #1
    if (huart->Instance == USART1)
    {
        static char rxBuffer[100];
        static uint8_t rxIndex = 0;

        if (rxByte1 == '\n' || rxByte1 == '\r')
        {
            if (rxIndex > 0)
            {
                rxBuffer[rxIndex] = '\0';
                Parse_Telemetry(rxBuffer);
                rxIndex = 0;
            }
        }
        else if (rxIndex < sizeof(rxBuffer) - 1)
        {
            rxBuffer[rxIndex++] = (char)rxByte1;
        }

        // Re-arm interrupt for next byte from Board #1
        HAL_UART_Receive_IT(&huart1, &rxByte1, 1);
    }

    // Channel B: User Keystrokes from Local Virtual Terminal
    else if (huart->Instance == USART3)
    {
        HUB_ReceiveHandler(rxByte3);

        // Re-arm interrupt for next byte from Virtual Terminal #2
        HAL_UART_Receive_IT(&huart3, &rxByte3, 1);
    }
}
