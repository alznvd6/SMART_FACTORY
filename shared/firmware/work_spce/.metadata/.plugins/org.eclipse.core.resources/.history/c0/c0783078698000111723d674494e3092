#include "environment.h"
#include <lcd_parallel.h>  // For the custom 20x4 parallel LCD driver
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define RX_BUFFER_SIZE             64

/* --- UI Menu State Machine Enumeration --- */
typedef enum {
    UI_STATE_MAIN_MENU,
    UI_STATE_MONITORING,
    UI_STATE_SETTINGS_AUTH,
    UI_STATE_SETTINGS_MENU,
    UI_STATE_CONTROL_AUTH,
    UI_STATE_CONTROL_MENU
} UI_State_t;

/* --- Private Variables --- */
static ADC_HandleTypeDef  *env_hadc  = NULL;
static UART_HandleTypeDef *env_huart = NULL;
static RTC_HandleTypeDef  *env_hrtc  = NULL;

/* Climate Dynamic Parameters */
static float target_temp = 25.0f;
static float tolerance_percent = 0.20f; // 20% Tolerance

/* Filtering Circular Buffer */
static float temp_history[MOVING_AVG_SAMPLES] = {25.0f};
static int   buffer_index = 0;
static int   total_samples_collected = 0;

/* Safety and Access State Tracking */
static uint32_t last_fire_detected_time = 0;
static uint8_t  is_system_locked = 0;
static uint8_t  fire_alarm_muted = 0;

/* UI State Controls */
static UI_State_t current_ui_state = UI_STATE_MAIN_MENU;
static uint8_t    ui_needs_refresh = 1;
static uint32_t   last_monitoring_update = 0;

/* Command Line Shell Buffer */
static char    rx_buffer[RX_BUFFER_SIZE];
static uint8_t rx_index = 0;

/* --- Private Helper Functions Prototypes --- */
static void  Add_Temperature_To_History(float new_temp);
static float Get_Average_Temperature(void);
static void  Control_Temperature_Actuators(float avg_temp);
static void  Control_Fire_Safety(char *fire_status_msg, size_t msg_max_len);
static void  Display_Current_UI(void);
static void  Process_Menu_Input(char *input);
static void  Update_LCD_Display(float current_temp);

/* --- Public Core Functions --- */

/**
 * @brief Initializes the Environment and Safety monitoring module
 */
void ENV_Init(ADC_HandleTypeDef *hadc_ptr, UART_HandleTypeDef *huart_ptr, RTC_HandleTypeDef *hrtc_ptr) {
    env_hadc  = hadc_ptr;
    env_huart = huart_ptr;
    env_hrtc  = hrtc_ptr;

    /* Clear Shell Buffer */
    memset(rx_buffer, 0, RX_BUFFER_SIZE);
    rx_index = 0;

    current_ui_state = UI_STATE_MAIN_MENU;
    ui_needs_refresh = 1;

    /* Pre-fill historical temperature buffer to avoid startup 0.0C glitches */
    for (int i = 0; i < MOVING_AVG_SAMPLES; i++) {
        temp_history[i] = 25.0f;
    }
    total_samples_collected = MOVING_AVG_SAMPLES;

    /* Setup Parallel LCD Device */
    lcd_init();
    lcd_clear();
    lcd_put_cur(0, 2);
    lcd_send_string("SYSTEM READY");
    lcd_put_cur(1, 1);
    lcd_send_string("INITIALIZING...");
    HAL_Delay(1000);
    lcd_clear();
}

/**
 * @brief Non-blocking UART Character Receiver Handler for UI Menu Shell
 */
void ENV_ReceiveHandler(uint8_t rx_char) {
    /* Mask or echo input contextually */
    if (current_ui_state == UI_STATE_SETTINGS_AUTH || current_ui_state == UI_STATE_CONTROL_AUTH) {
        char asterisk = '*';
        if (rx_char != '\r' && rx_char != '\n' && rx_char != '\b' && rx_char != 127) {
            HAL_UART_Transmit(env_huart, (uint8_t*)&asterisk, 1, 10);
        }
    } else {
        HAL_UART_Transmit(env_huart, &rx_char, 1, 10);
    }

    /* Check for Carriage Return or Line Feed (End of input command) */
    if (rx_char == '\r' || rx_char == '\n') {
        if (rx_index > 0) {
            rx_buffer[rx_index] = '\0';
            Process_Menu_Input(rx_buffer);
            rx_index = 0;
            memset(rx_buffer, 0, RX_BUFFER_SIZE);
        }
    }
    /* Check for Backspace */
    else if (rx_char == '\b' || rx_char == 127) {
        if (rx_index > 0) {
            rx_index--;
            rx_buffer[rx_index] = '\0';
            HAL_UART_Transmit(env_huart, (uint8_t*)"\b \b", 3, 10);
        }
    }
    /* Append character to command string if space is available safely */
    else if (rx_index < (RX_BUFFER_SIZE - 1)) {
        rx_buffer[rx_index++] = (char)rx_char;
    }
}

/**
 * @brief Periodic Task for execution inside the main background loop
 */
void ENV_Task(void) {
    uint32_t adc_value = 0;
    float current_temperature = 25.0f;
    char fire_status[30] = "CLEAR";

    /* 1. Sample Temperature Sensor via ADC channel */
    if (env_hadc != NULL) {
        HAL_ADC_Start(env_hadc);
        if (HAL_ADC_PollForConversion(env_hadc, 10) == HAL_OK) {
            adc_value = HAL_ADC_GetValue(env_hadc);
            current_temperature = ((float)adc_value * 330.0f) / 4095.0f;
            Add_Temperature_To_History(current_temperature);
        }
        HAL_ADC_Stop(env_hadc);
    }

    float average_temperature = Get_Average_Temperature();

    /* 2. Execute Safety Critical Monitor Core */
    Control_Fire_Safety(fire_status, sizeof(fire_status));

    /* 3. Execute Climate Control Loops based on Emergency Interlocks */
    if (!is_system_locked) {
        Control_Temperature_Actuators(average_temperature);
    } else {
        /* Emergency Shutdown: Safe state default */
        HAL_GPIO_WritePin(FAN_GPIO_Port, FAN_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(HEATER_GPIO_Port, HEATER_Pin, GPIO_PIN_RESET);
    }

    /* 4. Update physical character matrix LCD */
    Update_LCD_Display(average_temperature);

    /* 5. Periodic terminal tracking triggers (Only when monitoring and user isn't typing) */
    uint32_t current_time = HAL_GetTick();
    if (current_ui_state == UI_STATE_MONITORING) {
        if ((current_time - last_monitoring_update >= 1000U) && (rx_index == 0)) {
            last_monitoring_update = current_time;
            ui_needs_refresh = 1;
        }
    }

    /* 6. Process Terminal Redrawing Manager */
    if (ui_needs_refresh && (rx_index == 0)) {
        Display_Current_UI();
        ui_needs_refresh = 0;
    }
}

/* --- Private Helper Functions Implementation --- */

static void Update_LCD_Display(float current_temp) {
    char lcd_line[21];
    RTC_TimeTypeDef sTime = {0};
    RTC_DateTypeDef sDate = {0};
    static uint8_t fire_frame_select = 0;

    if (env_hrtc != NULL) {
        HAL_RTC_GetTime(env_hrtc, &sTime, RTC_FORMAT_BIN);
        HAL_RTC_GetDate(env_hrtc, &sDate, RTC_FORMAT_BIN);
    }

    /* Line 1: Date & Time Display */
    snprintf(lcd_line, sizeof(lcd_line), "[%02d/%02d]     %02d:%02d:%02d",
             sDate.Month, sDate.Date, sTime.Hours, sTime.Minutes, sTime.Seconds);
    lcd_put_cur(0, 0);
    lcd_send_string(lcd_line);

    /* Line 2: Temperatures Display */
    snprintf(lcd_line, sizeof(lcd_line), "Temp:%.1fC  Targ:%.1fC", current_temp, target_temp);
    lcd_put_cur(1, 0);
    lcd_send_string(lcd_line);

    /* Line 3: Operational Environment Status Display */
    lcd_put_cur(2, 0);
    if (current_temp > (target_temp * (1.0f + tolerance_percent))) {
        lcd_send_string("STATE: OVERTEMP (FAN)");
    } else if (current_temp < (target_temp * (1.0f - tolerance_percent))) {
        lcd_send_string("STATE: UNDERTEMP(HTR)");
    } else {
        lcd_send_string("STATE: NORMAL (SAFE) ");
    }

    /* Line 4: Safety Alarm Status */
    uint8_t fire_triggered = (HAL_GPIO_ReadPin(FIRE_1_GPIO_Port, FIRE_1_Pin) == GPIO_PIN_SET) ||
                             (HAL_GPIO_ReadPin(FIRE_2_GPIO_Port, FIRE_2_Pin) == GPIO_PIN_SET);

    lcd_put_cur(3, 0);
    if (fire_triggered || is_system_locked) {
        lcd_send_data(fire_frame_select);
        lcd_send_string("   FIRE ALERT!   ");
        lcd_send_data(fire_frame_select);
        fire_frame_select = !fire_frame_select;
    } else {
        lcd_send_string("ALARM: NO HAZARD    ");
    }
}

