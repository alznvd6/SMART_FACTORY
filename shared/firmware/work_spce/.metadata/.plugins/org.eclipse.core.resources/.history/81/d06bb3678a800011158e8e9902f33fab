static void Clear_Screen(void) {
    // 20 line feeds to simulate clear without color formatting bugs
    Send_PC("\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n");
