#include "environment.h"
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

// Private pointers to peripherals
static ADC_HandleTypeDef *env_hadc;
static UART_HandleTypeDef *env_huart;
static RTC_HandleTypeDef *env_hrtc;

// Dynamic climate
static float target_temp = 25.0f;
static float tolerance_percent = 0.20f;

// Circular Buffer Variables for Moving Average
static float temp_history[MOVING_AVG_SAMPLES] = {0};
static int buffer_index = 0;
static int total_samples_collected = 0;

// Fire Safety Lock-out State tracking
static uint32_t last_fire_detected_time = 0;
static uint8_t is_system_locked = 0;
static uint8_t fire_alarm_muted = 0;

// متغیرهای مدیریت ترمینال و پسورد ادمین
#define RX_BUFFER_SIZE 32
static char rx_buffer[RX_BUFFER_SIZE];
static uint8_t rx_index = 0;
static uint8_t is_admin = 0; // 0: کاربر عادی، 1: ادمین تایید شده

// Private Helper Functions
static void Add_Temperature_To_History(float new_temp);
static float Get_Average_Temperature(void);
static void Control_Temperature_Actuators(float avg_temp);
static void Control_Fire_Safety(char *fire_status_msg, size_t msg_max_len);
static void Parse_Admin_Command(char *cmd);

// Public: Initialize module
void ENV_Init(ADC_HandleTypeDef *hadc_ptr, UART_HandleTypeDef *huart_ptr) {
    env_hadc = hadc_ptr;
    env_huart = huart_ptr;
    env_hrtc = hrtc_ptr;
}
void ENV_ReceiveHandler(uint8_t rx_char) {
    HAL_UART_Transmit(env_huart, &rx_char, 1, 10);

    if (rx_char == '\r' || rx_char == '\n') {
        if (rx_index > 0) {
            rx_buffer[rx_index] = '\0';
            Parse_Admin_Command(rx_buffer);
            rx_index = 0;
        }
        char* new_line = "\r\n> ";
        HAL_UART_Transmit(env_huart, (uint8_t*)new_line, 4, 10);
    }
    else if (rx_char == '\b' && rx_index > 0) {
        rx_index--;
    }
    else if (rx_index < RX_BUFFER_SIZE - 1) {
        rx_buffer[rx_index++] = rx_char;
    }
}

static void Parse_Admin_Command(char *cmd) {
    char msg[64];

    // ۱. بررسی ورود ادمین با پسورد
    if (strncmp(cmd, "login ", 6) == 0) {
        char *pass = cmd + 6;
        if (strcmp(pass, "1111") == 0) {
            is_admin = 1;
            sprintf(msg, "\r\n[AUTH]: Admin logged in successfully!\r\n");
        } else {
            is_admin = 0;
            sprintf(msg, "\r\n[AUTH ERROR]: Invalid Password!\r\n");
        }
        HAL_UART_Transmit(env_huart, (uint8_t*)msg, strlen(msg), 100);
        return;
    }

    // خروج از حالت ادمین
    if (strcmp(cmd, "logout") == 0) {
        is_admin = 0;
        sprintf(msg, "\r\n[AUTH]: Logged out.\r\n");
        HAL_UART_Transmit(env_huart, (uint8_t*)msg, strlen(msg), 100);
        return;
    }

    // ۲. بررسی سطح دسترسی برای سایر دستورات کنترلی
    if (!is_admin) {
        sprintf(msg, "\r\n[DENIED]: Access Denied. Type 'login <pass>'\r\n");
        HAL_UART_Transmit(env_huart, (uint8_t*)msg, strlen(msg), 100);
        return;
    }

    // --- دستورات مخصوص ادمین ---

    // تغییر دمای هدف (مثال: set_temp 28.5)
    if (strncmp(cmd, "set_temp ", 9) == 0) {
        target_temp = atof(cmd + 9);
        sprintf(msg, "\r\n[SUCCESS]: Target Temp set to %.1f C\r\n", target_temp);
    }
    // ریست کردن کل سیستم ایمنی و اقلیم
    else if (strcmp(cmd, "reset_sys") == 0) {
        is_system_locked = 0;
        fire_alarm_muted = 0;
        total_samples_collected = 0;
        buffer_index = 0;
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_5|GPIO_PIN_6|GPIO_PIN_7, GPIO_PIN_RESET);
        sprintf(msg, "\r\n[SUCCESS]: System completely reset.\r\n");
    }
    // خاموش کردن دستی یا بی‌صدا کردن آژیر حریق
    else if (strcmp(cmd, "mute_alarm") == 0) {
        fire_alarm_muted = 1;
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET); // خاموش کردن بازر
        sprintf(msg, "\r\n[SUCCESS]: Alarm Siren Muted.\r\n");
    }
    // دستور نامعتبر
    else {
        sprintf(msg, "\r\n[ERROR]: Command not recognized.\r\n");
    }

    HAL_UART_Transmit(env_huart, (uint8_t*)msg, strlen(msg), 100);
}
void ENV_Task(void) {
    uint32_t adc_value = 0;
    float current_temperature = 0.0f;
    float average_temperature = 0.0f;
    char fire_status[30] = "CLEAR";
    char uart_buffer[160];

    // متغیرهای ساختار زمان و تاریخ RTC
    RTC_TimeTypeDef sTime = {0};
    RTC_DateTypeDef sDate = {0};

    // خواندن ساعت و تاریخ از RTC داخلی
    HAL_RTC_GetTime(env_hrtc, &sTime, RTC_FORMAT_BIN);
    HAL_RTC_GetDate(env_hrtc, &sDate, RTC_FORMAT_BIN);

    // ۱. قرائت سنسور دما
    HAL_ADC_Start(env_hadc);
    if (HAL_ADC_PollForConversion(env_hadc, 10) == HAL_OK) {
        adc_value = HAL_ADC_GetValue(env_hadc);
        current_temperature = ((float)adc_value * 330.0f) / 4095.0f;
        Add_Temperature_To_History(current_temperature);
    }
    HAL_ADC_Stop(env_hadc);

    average_temperature = Get_Average_Temperature();

    // ۲. پردازش هسته‌های ایمنی و اقلیم
    Control_Fire_Safety(fire_status, sizeof(fire_status));

    // اگر حریق قفل نبود، سیستم اقلیم عادی کار کند
    if (!is_system_locked) {
        Control_Temperature_Actuators(average_temperature);
    } else {
        // در زمان حریق، فن و هیتر جهت ایمنی خاموش شوند
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1 | GPIO_PIN_2, GPIO_PIN_RESET);
    }

    // ۳. آماده‌سازی و ارسال گزارش کامل به ترمینال به همراه زمان و تاریخ دقیق
    // فرمت خروجی: [Date] | [Time] | Temp Metrics | Safety Status | Role status
    snprintf(uart_buffer, sizeof(uart_buffer),
             "\r\n[%04d-%02d-%02d] | [%02d:%02d:%02d] | T_Cur: %.1f C, T_Avg: %.1f C (Target: %.1f) | Fire: %s | Role: %s\r\n",
             2000 + sDate.Year, sDate.Month, sDate.Date,
             sTime.Hours, sTime.Minutes, sTime.Seconds,
             current_temperature, average_temperature, target_temp,
             fire_status, is_admin ? "ADMIN" : "USER");

    HAL_UART_Transmit(env_huart, (uint8_t*)uart_buffer, strlen(uart_buffer), 200);
}

// پیاده‌سازی فیلتر میانگین متحرک
static void Add_Temperature_To_History(float new_temp) {
    temp_history[buffer_index] = new_temp;
    buffer_index = (buffer_index + 1) % MOVING_AVG_SAMPLES;
    if (total_samples_collected < MOVING_AVG_SAMPLES) {
        total_samples_collected++;
    }
}

static float Get_Average_Temperature(void) {
    float sum = 0.0f;
    for (int i = 0; i < total_samples_collected; i++) {
        sum += temp_history[i];
    }
    return (total_samples_collected > 0) ? (sum / (float)total_samples_collected) : 0.0f;
}

// کنترل هوشمند فن و هیتر براساس مقادیر داینامیک ادمین
static void Control_Temperature_Actuators(float avg_temp) {
    float high_thresh = target_temp * (1.0f + tolerance_percent);
    float low_thresh = target_temp * (1.0f - tolerance_percent);

    if (avg_temp > high_thresh) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, GPIO_PIN_SET);   // FAN ON
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_RESET); // HEATER OFF
    } else if (avg_temp < low_thresh) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, GPIO_PIN_RESET); // FAN OFF
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_SET);   // HEATER ON
    } else {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1 | GPIO_PIN_2, GPIO_PIN_RESET);
    }
}

// الگوریتم ایمنی حریق با قابلیت دکمه Mute ادمین
static void Control_Fire_Safety(char *fire_status_msg, size_t msg_len) {
    uint8_t fire1 = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_3) == GPIO_PIN_SET);
    uint8_t fire2 = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == GPIO_PIN_SET);
    uint32_t current_time = HAL_GetTick();

    if (fire1 || fire2) {
        last_fire_detected_time = current_time;
        is_system_locked = 1;
    }
    else if (is_system_locked && (current_time - last_fire_detected_time >= ALARM_LOCK_DURATION_MS)) {
        is_system_locked = 0;
        fire_alarm_muted = 0; // ریست شدن فلگ بی‌صدا پس از پایان خطر
    }

    if (is_system_locked) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, fire1 ? GPIO_PIN_SET : GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, fire2 ? GPIO_PIN_SET : GPIO_PIN_RESET);

        // تولید صدای بازر صوتی به شرطی که ادمین آن را Mute نکرده باشد
        if (!fire_alarm_muted) {
            HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_7);
        } else {
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
        }

        snprintf(fire_status_msg, msg_len, "!!! DANGER !!!");
    } else {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5 | GPIO_PIN_6 | GPIO_PIN_7, GPIO_PIN_RESET);
        snprintf(fire_status_msg, msg_len, "SAFE");
    }
}
