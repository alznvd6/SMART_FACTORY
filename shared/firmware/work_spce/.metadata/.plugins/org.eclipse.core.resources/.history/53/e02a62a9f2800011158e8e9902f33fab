Factory_Telemetry_t latest_factory_data;

static UART_HandleTypeDef *huart_env;
static UART_HandleTypeDef *huart_pc;
static UART_HandleTypeDef *huart_py;

typedef enum {
    UI_STATE_MAIN_MENU = 0,
    UI_STATE_MONITORING,
    UI_STATE_ENTER_PASSWORD,
    UI_STATE_ADMIN_MENU,
    UI_STATE_SET_TEMP,
    UI_STATE_SET_TIME,
    UI_STATE_SET_DATE
} UI_State_t;

static UI_State_t current_state = UI_STATE_MAIN_MENU;

static char  telemetry_time[9]  = "00:00:00";
static char  telemetry_date[9]  = "00-00-00";
static float telemetry_cur_temp = 0.0f;
static float telemetry_avg_temp = 0.0f;
static float telemetry_target   = 25.0f;
static int   telemetry_fire     = 0;
static int   telemetry_lock     = 0;

#define CLI_INPUT_MAX           32
static char             cli_input[CLI_INPUT_MAX];
static volatile uint8_t cli_index = 0;
static volatile uint8_t cli_line_ready = 0;

#define TEL_INPUT_MAX           128
static char             tel_input[TEL_INPUT_MAX];
static volatile uint8_t tel_index = 0;
static volatile uint8_t tel_packet_ready = 0;

static uint8_t  ui_needs_refresh = 1;
static uint32_t last_monitor_refresh_tick = 0;

// Slower UI Update Rate: Bumped to 3 seconds to protect console typing focus
#define MONITOR_REFRESH_INTERVAL_MS  3000

#define ADMIN_PASSWORD          "2222"

static char     feedback_message[64] = "";
static uint32_t feedback_start_tick = 0;
static uint8_t  showing_feedback = 0;
#define FEEDBACK_DURATION_MS    2000

static void Process_Telemetry_Packet(char *packet);
static void Process_CLI_Command(char *cmd);
static void Render_Terminal_UI(void);
static void Clear_Screen(void);
static void Send_PC(const char *str);
static float Custom_Atof(const char *p);

void HUB_Init(UART_HandleTypeDef *huart_env_ptr, UART_HandleTypeDef *huart_pc_ptr, UART_HandleTypeDef *huart_py_ptr) {
    huart_env = huart_env_ptr;
    huart_pc  = huart_pc_ptr;
    huart_py  = huart_py_ptr;

    memset(cli_input, 0, CLI_INPUT_MAX);
    cli_index = 0;
    cli_line_ready = 0;
    ui_needs_refresh = 1;
}

void HUB_ReceiveHandler(uint8_t rx_char, uint8_t uart_id) {
    if (uart_id == 1) {
        if (tel_packet_ready) return;
        if (rx_char == '\n' || rx_char == '\r') {
            if (tel_index > 0) {
                tel_input[tel_index] = '\0';
                tel_packet_ready = 1;
            }
        } else if (tel_index < (TEL_INPUT_MAX - 1)) {
            tel_input[tel_index++] = (char)rx_char;
        }
    }
    // Handle input arriving from Python/COMPIM (ID 3 assigned in callback)
    else if (uart_id == 3) {
        if (cli_line_ready) return;

        if (rx_char == '\r' || rx_char == '\n') {
            if (cli_index > 0) {
                cli_input[cli_index] = '\0';
                cli_line_ready = 1;
            }
        } else if (rx_char == '\b' || rx_char == 127) {
            if (cli_index > 0) {
                cli_index--;
                cli_input[cli_index] = '\0';
                Send_PC("\b \b");
            }
        } else if (cli_index < (CLI_INPUT_MAX - 1)) {
            cli_input[cli_index++] = (char)rx_char;
            if (current_state == UI_STATE_ENTER_PASSWORD) {
                Send_PC("*");
            } else {
                char echo[2] = { (char)rx_char, '\0' };
                Send_PC(echo);
            }
        }
    }
}

void HUB_Task(void) {
    uint32_t current_tick = HAL_GetTick();

    if (tel_packet_ready) {
        Process_Telemetry_Packet(tel_input);
        tel_index = 0;
        memset(tel_input, 0, TEL_INPUT_MAX);
        tel_packet_ready = 0;

        if (current_state == UI_STATE_MONITORING) {
            if (current_tick - last_monitor_refresh_tick >= MONITOR_REFRESH_INTERVAL_MS) {
                ui_needs_refresh = 1;
                last_monitor_refresh_tick = current_tick;
            }
        }
    }

    if (cli_line_ready) {
        Process_CLI_Command(cli_input);
        cli_index = 0;
        memset(cli_input, 0, CLI_INPUT_MAX);
        cli_line_ready = 0;
        ui_needs_refresh = 1;
    }

    if (showing_feedback && (current_tick - feedback_start_tick >= FEEDBACK_DURATION_MS)) {
        showing_feedback = 0;
        memset(feedback_message, 0, sizeof(feedback_message));
        ui_needs_refresh = 1;
    }

    if (ui_needs_refresh) {
        ui_needs_refresh = 0;
        Render_Terminal_UI();
    }
}

static void Process_CLI_Command(char *cmd) {
    // IMPORTANT Rule Check: Global override to drop back to main dashboard
    if (strcmp(cmd, "0") == 0) {
        current_state = UI_STATE_MAIN_MENU;
        snprintf(feedback_message, sizeof(feedback_message), "Returned to Main Menu.");
        feedback_start_tick = HAL_GetTick();
        showing_feedback = 1;
        return;
    }

    switch (current_state) {
        case UI_STATE_MAIN_MENU:
            if (strcmp(cmd, "1") == 0) {
                current_state = UI_STATE_MONITORING;
                last_monitor_refresh_tick = HAL_GetTick();
            } else if (strcmp(cmd, "2") == 0) {
                current_state = UI_STATE_ENTER_PASSWORD;
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Invalid Option. Choose 1 or 2.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            }
            break;

        case UI_STATE_MONITORING:
            // Handled by global zero checker, any other character triggers immediate refresh
            ui_needs_refresh = 1;
            break;

        case UI_STATE_ENTER_PASSWORD:
            if (strcmp(cmd, ADMIN_PASSWORD) == 0) {
                current_state = UI_STATE_ADMIN_MENU;
                snprintf(feedback_message, sizeof(feedback_message), "Login Approved.");
            } else {
                current_state = UI_STATE_MAIN_MENU;
                snprintf(feedback_message, sizeof(feedback_message), "Incorrect Password!");
            }
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            break;

        case UI_STATE_ADMIN_MENU:
            if (strcmp(cmd, "1") == 0) {
                current_state = UI_STATE_SET_TEMP;
            } else if (strcmp(cmd, "2") == 0) {
                current_state = UI_STATE_SET_TIME;
            } else if (strcmp(cmd, "3") == 0) {
                current_state = UI_STATE_SET_DATE;
            } else if (strcmp(cmd, "4") == 0) {
                HAL_UART_Transmit(huart_env, (uint8_t*)"reset_sys\n", 10, 100);
                snprintf(feedback_message, sizeof(feedback_message), "System Interlocks Cleared.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            } else if (strcmp(cmd, "5") == 0) {
                HAL_UART_Transmit(huart_env, (uint8_t*)"mute_alarm\n", 11, 100);
                snprintf(feedback_message, sizeof(feedback_message), "Alarm Muted.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            } else if (strcmp(cmd, "6") == 0) {
                current_state = UI_STATE_MAIN_MENU;
                snprintf(feedback_message, sizeof(feedback_message), "Logged Out.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Unknown Admin Option.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            }
            break;

        case UI_STATE_SET_TEMP: {
            char tx_cmd[32];
            snprintf(tx_cmd, sizeof(tx_cmd), "set_temp %s\n", cmd);
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);
            snprintf(feedback_message, sizeof(feedback_message), "Temp Target sent: %s C", cmd);
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            current_state = UI_STATE_ADMIN_MENU;
            break;
        }

        case UI_STATE_SET_TIME: {
            char tx_cmd[32];
            snprintf(tx_cmd, sizeof(tx_cmd), "set_time %s\n", cmd);
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);
            snprintf(feedback_message, sizeof(feedback_message), "Time Sync sent: %s", cmd);
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            current_state = UI_STATE_ADMIN_MENU;
            break;
        }

        case UI_STATE_SET_DATE: {
            char tx_cmd[32];
            snprintf(tx_cmd, sizeof(tx_cmd), "set_date %s\n", cmd);
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);
            snprintf(feedback_message, sizeof(feedback_message), "Date Sync sent: %s", cmd);
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            current_state = UI_STATE_ADMIN_MENU;
            break;
        }
    }
}

static void Render_Terminal_UI(void) {
    char frame[1024];
    memset(frame, 0, sizeof(frame));
    Clear_Screen();

    switch (current_state) {
        case UI_STATE_MAIN_MENU:
            snprintf(frame, sizeof(frame),
                     "\r\nSMART COLDROOM DISTRIBUTED DASHBOARD\r\n\r\n"
                     "[1] Monitor Telemetry Values\r\n"
                     "[2] Administration Settings\r\n\r\n"
                     "Menu Select> ");
            break;

        case UI_STATE_MONITORING:
            snprintf(frame, sizeof(frame),
                     "====================================================\r\n"
                     "                TELEMETRY MONITORING                \r\n"
                     "====================================================\r\n"
                     "  System Time  : %s  |  System Date : %s\r\n"
                     "----------------------------------------------------\r\n"
                     "  Current Temp : %.1f C\r\n"
                     "  Average Temp : %.1f C\r\n"
                     "  Target Temp  : %.1f C\r\n"
                     "  Safety Flag  : %s\r\n"
                     "  Hardware Lock: %s\r\n"
                     "----------------------------------------------------\r\n"
                     "  Press [0] at any time to return to Main Menu\r\n"
                     "====================================================\r\n"
                     "Console Refresh Active> ");
            break;

        case UI_STATE_ENTER_PASSWORD:
            snprintf(frame, sizeof(frame),
                     "====================================================\r\n"
                     "              ADMIN SECURITY VERIFICATION           \r\n"
                     "====================================================\r\n"
                     "  Enter Password (0 to cancel): ");
            break;

        case UI_STATE_ADMIN_MENU:
            snprintf(frame, sizeof(frame),
                     "\r\nADMIN CONTROL CENTER\r\n\r\n"
                     "[1] Set Target Temperature\r\n"
                     "[2] Sync System Time (Format: HH:MM:SS)\r\n"
                     "[3] Sync System Date (Format: YY:MM:DD)\r\n"
                     "[4] Reset System Interlocks / Alarm\r\n"
                     "[5] Mute Alarm Buzzer\r\n"
                     "[6] Logout\r\n\r\n"
                     "Admin Option> ");
            break;

        case UI_STATE_SET_TEMP:
            snprintf(frame, sizeof(frame), "Set Temp (Format XX.X)> ");
            break;

        case UI_STATE_SET_TIME:
            snprintf(frame, sizeof(frame), "Sync Time (HH:MM:SS)> ");
            break;

        case UI_STATE_SET_DATE:
            snprintf(frame, sizeof(frame), "Sync Date (YY:MM:DD)> ");
            break;
    }

    if (showing_feedback && (strlen(frame) + strlen(feedback_message) < 1000)) {
        char status_footer[128];
        snprintf(status_footer, sizeof(status_footer), "\r\n[STATUS: %s]", feedback_message);
        strcat(frame, status_footer);
    }

    Send_PC(frame);
}

static void Clear_Screen(void) {
    // Sends ANSI clear sequence instead of giant breaks, minimizing terminal blinking
    Send_PC("\033[2J\033[H");
}

static void Send_PC(const char *str) {
    // ROUTED TO PYTHON (huart_py) instead of standard terminal panel
    HAL_UART_Transmit(huart_py, (uint8_t*)str, strlen(str), 1000);
}

