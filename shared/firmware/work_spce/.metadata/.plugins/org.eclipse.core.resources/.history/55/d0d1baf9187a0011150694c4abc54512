/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  HAL_NVIC_SetPriority(USART1_IRQn, 0, 0);
  HAL_NVIC_EnableIRQ(USART1_IRQn);
  HAL_UART_Receive_IT(&huart1, &rxByte, 1);


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // 1. Non-blocking periodic UI Refresh (Every 500ms)
      if (HAL_GetTick() - lastDisplayTick >= 500)
      {
          lastDisplayTick = HAL_GetTick();

          // Clear terminal screen and print layout
          char clearScreen[] = "\033[2J\033[H";
          HAL_UART_Transmit(&huart1, (uint8_t*)clearScreen, strlen(clearScreen), HAL_MAX_DELAY);

          char uiBuffer[200];
          snprintf(uiBuffer, sizeof(uiBuffer),
                   "====================================\r\n"
                   " BOARD #2 CONSOLE\r\n"
                   " Remote ADC Value From U1: %s\r\n"
                   "====================================\r\n"
                   " Latest msg from Board #1: %s\r\n"
                   "====================================\r\n"
                   " Your msg for board #1 (Type + Enter): %s",
                   sharedAdcValue, messageFromBoard1, rxBuffer);

          HAL_UART_Transmit(&huart1, (uint8_t*)uiBuffer, strlen(uiBuffer), HAL_MAX_DELAY);
      }

      // 2. Process complete input string from local terminal typing
      if (lineReadyFromTerminal == 1)
      {
          // Transmit text down the wire to Board 1 prefixed with '#' identifier
          char txPacket[60];
          snprintf(txPacket, sizeof(txPacket), "#%s\n", rxBuffer);
          HAL_UART_Transmit(&huart1, (uint8_t*)txPacket, strlen(txPacket), HAL_MAX_DELAY);

          // Reset buffer local configuration states
          memset(rxBuffer, 0, sizeof(rxBuffer));
          rxIndex = 0;
          lineReadyFromTerminal = 0;

          // Re-arm interrupt structure
          HAL_UART_Receive_IT(&huart1, &rxByte, 1);
      }
      /* USER CODE END WHILE */
  }

