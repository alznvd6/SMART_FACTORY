#include "hub.h"
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Define the global variable declared in hub.h */
Factory_Telemetry_t latest_factory_data;

/* --- Hardware Interfaces --- */
static UART_HandleTypeDef *huart_env;  // UART1: Connected to Board #1
static UART_HandleTypeDef *huart_pc;   // UART3: Connected to PC CLI Terminal

/* --- UI State Management --- */
typedef enum {
    UI_STATE_MONITOR = 0,
    UI_STATE_ENTER_PASSWORD,
    UI_STATE_ADMIN_MENU,
    UI_STATE_SET_TEMP,
    UI_STATE_SET_TIME,
    UI_STATE_SET_DATE
} UI_State_t;

static UI_State_t current_state = UI_STATE_MONITOR;

/* --- Buffered Data from Board #1 Telemetry --- */
static char  telemetry_time[9]  = "00:00:00";
static char  telemetry_date[9]  = "00-00-00";
static float telemetry_cur_temp = 0.0f;
static float telemetry_avg_temp = 0.0f;
static float telemetry_target   = 25.0f;
static int   telemetry_fire     = 0;
static int   telemetry_lock     = 0;

/* --- Local Input Buffers --- */
#define CLI_INPUT_MAX           32
static char             cli_input[CLI_INPUT_MAX];
static volatile uint8_t cli_index = 0;
static volatile uint8_t cli_line_ready = 0;

#define TEL_INPUT_MAX           128
static char             tel_input[TEL_INPUT_MAX];
static volatile uint8_t tel_index = 0;
static volatile uint8_t tel_packet_ready = 0;

/* --- UI Force Redraw Flag --- */
static uint8_t ui_needs_refresh = 1;

/* --- Administrative Access --- */
#define ADMIN_PASSWORD          "admin123"
static char    entered_password[16] = "";

/* --- Non-Blocking Feedback Timer --- */
static char     feedback_message[64] = "";
static uint32_t feedback_start_tick = 0;
static uint8_t  showing_feedback = 0;

#define FEEDBACK_DURATION_MS    1500
#define UI_REFRESH_INTERVAL_MS  1000 // Checked as a slow fallback heartbeat

/* --- Private Function Prototypes --- */
static void Process_Telemetry_Packet(char *packet);
static void Process_CLI_Command(char *cmd);
static void Render_Terminal_UI(void);
static void Clear_Screen(void);
static void Send_PC(const char *str);
static float Custom_Atof(const char *p);

/* --- Core Public API --- */

/**
 * @brief Initializes the Central Hub
 */
void HUB_Init(UART_HandleTypeDef *huart_env_ptr, UART_HandleTypeDef *huart_pc_ptr) {
    huart_env = huart_env_ptr;
    huart_pc  = huart_pc_ptr;

    memset(cli_input, 0, CLI_INPUT_MAX);
    cli_index = 0;
    cli_line_ready = 0;

    memset(tel_input, 0, TEL_INPUT_MAX);
    tel_index = 0;
    tel_packet_ready = 0;

    memset(&latest_factory_data, 0, sizeof(latest_factory_data));

    Clear_Screen();
    // Using hex escapes "\x1B" instead of "\033" to prevent parser bugs
    Send_PC("\x1B[1;32mHUB CONTROLLER INITIALIZED. WAITING FOR DATA...\r\n\x1B[0m");
    ui_needs_refresh = 1;
}

/**
 * @brief Handle incoming characters from ISR context
 * @param uart_id 1 for Telemetry (UART1), 3 for CLI (UART3)
 */
void HUB_ReceiveHandler(uint8_t rx_char, uint8_t uart_id) {
    // 1. From Board #1 (Telemetry)
    if (uart_id == 1) {
        if (tel_packet_ready) return; // Wait for previous to clear

        if (rx_char == '\n' || rx_char == '\r') {
            if (tel_index > 0) {
                tel_input[tel_index] = '\0';
                tel_packet_ready = 1;
            }
        } else if (tel_index < (TEL_INPUT_MAX - 1)) {
            tel_input[tel_index++] = (char)rx_char;
        }
    }
    // 2. From PC Terminal (Command Input)
    else if (uart_id == 3) {
        if (cli_line_ready) return; // Wait for command execution

        if (rx_char == '\r' || rx_char == '\n') {
            if (cli_index > 0) {
                cli_input[cli_index] = '\0';
                cli_line_ready = 1;
            }
        } else if (rx_char == '\b' || rx_char == 127) {
            if (cli_index > 0) {
                cli_index--;
                cli_input[cli_index] = '\0';
                Send_PC("\b \b"); // Securely wipe character from display
            }
        } else if (cli_index < (CLI_INPUT_MAX - 1)) {
            cli_input[cli_index++] = (char)rx_char;

            // Mask password entry with asterisks
            if (current_state == UI_STATE_ENTER_PASSWORD) {
                Send_PC("*");
            } else {
                char echo[2] = { (char)rx_char, '\0' };
                Send_PC(echo);
            }
        }
    }
}

/**
 * @brief Main execution task scheduled in the background loop
 */
void HUB_Task(void) {
    static uint32_t last_ui_tick = 0;
    uint32_t current_tick = HAL_GetTick();

    // 1. Parse Telemetry incoming from Board #1
    if (tel_packet_ready) {
        Process_Telemetry_Packet(tel_input);
        tel_index = 0;
        memset(tel_input, 0, TEL_INPUT_MAX);
        tel_packet_ready = 0;
        ui_needs_refresh = 1; // Flag layout update immediately
    }

    // 2. Parse Commands typed into PC Terminal
    if (cli_line_ready) {
        Process_CLI_Command(cli_input);
        cli_index = 0;
        memset(cli_input, 0, CLI_INPUT_MAX);
        cli_line_ready = 0;
        ui_needs_refresh = 1; // Flag updates on state transitions
    }

    // 3. Clear Feedback Message after expiration timer finishes
    if (showing_feedback && (current_tick - feedback_start_tick >= FEEDBACK_DURATION_MS)) {
        showing_feedback = 0;
        memset(feedback_message, 0, sizeof(feedback_message));
        ui_needs_refresh = 1;
    }

    // 4. Update CLI Terminal View (Fallback periodic check or forced event refresh)
    if (ui_needs_refresh || (current_tick - last_ui_tick >= UI_REFRESH_INTERVAL_MS)) {
        last_ui_tick = current_tick;
        ui_needs_refresh = 0;
        Render_Terminal_UI();
    }
}

/* --- Private Parsing Engine --- */

static void Process_Telemetry_Packet(char *packet) {
    if (packet == NULL || packet[0] != '@') return;

    char *token = strtok(packet, "|");
    while (token != NULL) {
        if (strncmp(token, "@TIME=", 6) == 0 && strlen(token) >= 14) {
            strncpy(telemetry_time, token + 6, 8);
            telemetry_time[8] = '\0';

            // Populate struct
            int hh = 0, mm = 0, ss = 0;
            if (sscanf(telemetry_time, "%d:%d:%d", &hh, &mm, &ss) == 3) {
                latest_factory_data.time_hh = (uint8_t)hh;
                latest_factory_data.time_mm = (uint8_t)mm;
                latest_factory_data.time_ss = (uint8_t)ss;
            }
        } else if (strncmp(token, "DATE=", 5) == 0 && strlen(token) >= 13) {
            strncpy(telemetry_date, token + 5, 8);
            telemetry_date[8] = '\0';

            // Populate struct
            int yy = 0, mn = 0, dd = 0;
            if (sscanf(telemetry_date, "%d-%d-%d", &yy, &mn, &dd) == 3) {
                latest_factory_data.date_yy = (uint8_t)yy;
                latest_factory_data.date_mm = (uint8_t)mn;
                latest_factory_data.date_dd = (uint8_t)dd;
            }
        } else if (strncmp(token, "CUR=", 4) == 0) {
            telemetry_cur_temp = Custom_Atof(token + 4);
            latest_factory_data.current_temp = telemetry_cur_temp;
        } else if (strncmp(token, "AVG=", 4) == 0) {
            telemetry_avg_temp = Custom_Atof(token + 4);
            latest_factory_data.avg_temp = telemetry_avg_temp;
        } else if (strncmp(token, "FIRE=", 5) == 0) {
            telemetry_fire = atoi(token + 5);
            latest_factory_data.fire_triggered = (uint8_t)telemetry_fire;
        } else if (strncmp(token, "LOCK=", 5) == 0) {
            telemetry_lock = atoi(token + 5);
            latest_factory_data.system_locked = (uint8_t)telemetry_lock;
        } else if (strncmp(token, "TARG=", 5) == 0) {
            telemetry_target = Custom_Atof(token + 5);
            latest_factory_data.target_temp = telemetry_target;
        }
        token = strtok(NULL, "|");
    }
}

static void Process_CLI_Command(char *cmd) {
    switch (current_state) {
        case UI_STATE_MONITOR:
            if (strcmp(cmd, "admin") == 0) {
                current_state = UI_STATE_ENTER_PASSWORD;
                memset(entered_password, 0, sizeof(entered_password));
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Unknown command. Type 'admin' to log in.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            }
            break;

        case UI_STATE_ENTER_PASSWORD:
            if (strcmp(cmd, ADMIN_PASSWORD) == 0) {
                current_state = UI_STATE_ADMIN_MENU;
                snprintf(feedback_message, sizeof(feedback_message), "Access Granted! Welcome Admin.");
            } else {
                current_state = UI_STATE_MONITOR;
                snprintf(feedback_message, sizeof(feedback_message), "Access Denied. Incorrect Password.");
            }
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            break;

        case UI_STATE_ADMIN_MENU:
            if (strcmp(cmd, "1") == 0) {
                current_state = UI_STATE_SET_TEMP;
            } else if (strcmp(cmd, "2") == 0) {
                current_state = UI_STATE_SET_TIME;
            } else if (strcmp(cmd, "3") == 0) {
                current_state = UI_STATE_SET_DATE;
            } else if (strcmp(cmd, "4") == 0) {
                HAL_UART_Transmit(huart_env, (uint8_t*)"reset_sys\r\n", 11, 100);
                snprintf(feedback_message, sizeof(feedback_message), "System Alarm Interlocks Reset Sent.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            } else if (strcmp(cmd, "5") == 0) {
                HAL_UART_Transmit(huart_env, (uint8_t*)"mute_alarm\r\n", 12, 100);
                snprintf(feedback_message, sizeof(feedback_message), "Alarm Audio Mute Command Sent.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            } else if (strcmp(cmd, "6") == 0) {
                current_state = UI_STATE_MONITOR;
                snprintf(feedback_message, sizeof(feedback_message), "Logged Out.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Invalid Option.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            }
            break;

        case UI_STATE_SET_TEMP: {
            char tx_cmd[32];
            snprintf(tx_cmd, sizeof(tx_cmd), "set_temp %s\r\n", cmd);
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);

            snprintf(feedback_message, sizeof(feedback_message), "Target Temp updated to: %s C", cmd);
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            current_state = UI_STATE_ADMIN_MENU;
            break;
        }

        case UI_STATE_SET_TIME: {
            char tx_cmd[32];
            snprintf(tx_cmd, sizeof(tx_cmd), "set_time %s\r\n", cmd);
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);

            snprintf(feedback_message, sizeof(feedback_message), "System Time updated to: %s", cmd);
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            current_state = UI_STATE_ADMIN_MENU;
            break;
        }

        case UI_STATE_SET_DATE: {
            char tx_cmd[32];
            snprintf(tx_cmd, sizeof(tx_cmd), "set_date %s\r\n", cmd);
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);

            snprintf(feedback_message, sizeof(feedback_message), "System Date updated to: %s", cmd);
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            current_state = UI_STATE_ADMIN_MENU;
            break;
        }
    }
}

/* --- CLI Drawing Engine --- */

static void Render_Terminal_UI(void) {
    char frame[1200];
    char dynamic_body[512] = "";

    // Header structure using hexadecimal escapes (\x1B)
    snprintf(frame, sizeof(frame),
             "\x1B[H" // Force cursor to Home index
             "\x1B[1;36m====================================================\r\n"
             "        SMART COLDROOM DISTRIBUTED DASHBOARD        \r\n"
             "====================================================\x1B[0m\r\n"
             "  Time: %s  |  Date: %s\r\n"
             "----------------------------------------------------\r\n"
             "  Current Temp : \x1B[1;33m%.1f C\x1B[0m\r\n"
             "  Average Temp : \x1B[1;33m%.1f C\x1B[0m\r\n"
             "  Target Temp  : \x1B[1;35m%.1f C\x1B[0m\r\n"
             "  Status       : %s\r\n"
             "  Safety Lock  : %s\r\n"
             "====================================================\r\n",
             telemetry_time, telemetry_date,
             telemetry_cur_temp, telemetry_avg_temp, telemetry_target,
             telemetry_fire ? "\x1B[1;31m!!! FIRE DETECTED !!!\x1B[0m" : "\x1B[1;32mSECURE (NORMAL)\x1B[0m",
             telemetry_lock ? "\x1B[1;31mACTIVE LOCKED (SAFETY SHUTDOWN)\x1B[0m" : "\x1B[1;32mOFF (SYSTEM ACTIVE)\x1B[0m");

    switch (current_state) {
        case UI_STATE_MONITOR:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Type \x1B[1;32m'admin'\x1B[0m to log in to settings panel.\r\n"
                     "\r\n"
                     "Console> ");
            break;

        case UI_STATE_ENTER_PASSWORD:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  \x1B[1;33mENTER ADMIN PASSWORD:\x1B[0m\r\n"
                     "  Password: ");
            break;

        case UI_STATE_ADMIN_MENU:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "  \x1B[1;32mADMIN CONTROL CENTER\x1B[0m\r\n"
                     "  [1] Set Target Temperature\r\n"
                     "  [2] Sync System Time (Format: HH:MM:SS)\r\n"
                     "  [3] Sync System Date (Format: YY:MM:DD)\r\n"
                     "  [4] Reset System Interlocks / Alarm\r\n"
                     "  [5] Mute Alarm Buzzer\r\n"
                     "  [6] Logout\r\n"
                     "----------------------------------------------------\r\n"
                     "Admin Option> ");
            break;

        case UI_STATE_SET_TEMP:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Enter new Target Temperature (Format: XX.X): ");
            break;

        case UI_STATE_SET_TIME:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Enter System Time (Format: HH:MM:SS): ");
            break;

        case UI_STATE_SET_DATE:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Enter System Date (Format: YY:MM:DD): ");
            break;
    }

    strcat(frame, dynamic_body);

    if (showing_feedback) {
        char status_footer[128];
        snprintf(status_footer, sizeof(status_footer), "\r\n\x1B[1;33m[STATUS: %s]\x1B[0m", feedback_message);
        strcat(frame, status_footer);
    }

    Send_PC(frame);
}

/* --- Support Utilities --- */

static void Clear_Screen(void) {
    Send_PC("\x1B[2J\x1B[H");
}

static void Send_PC(const char *str) {
    HAL_UART_Transmit(huart_pc, (uint8_t*)str, strlen(str), 200);
}

static float Custom_Atof(const char *p) {
    while (*p == ' ') p++;
    float val = 0.0f;
    float sign = 1.0f;
    if (*p == '-') { sign = -1.0f; p++; }
    else if (*p == '+') { p++; }
    while (*p >= '0' && *p <= '9') {
        val = val * 10.0f + (*p - '0');
        p++;
    }
    if (*p == '.') {
        p++;
        float divisor = 10.0f;
        while (*p >= '0' && *p <= '9') {
            val += (*p - '0') / divisor;
            divisor *= 10.0f;
            p++;
        }
    }
    return val * sign;
}
