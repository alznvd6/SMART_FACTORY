static void Process_Menu_Input(char *input) {
    char feedback[128];

    if (strcmp(input, "0") == 0) {
        current_ui_state = UI_STATE_MAIN_MENU;
        ui_needs_refresh = 1;
        return;
    }

    switch (current_ui_state) {
        case UI_STATE_MAIN_MENU:
            if (strcmp(input, "1") == 0) {
                current_ui_state = UI_STATE_MONITORING;
                last_monitoring_update = HAL_GetTick();
            } else if (strcmp(input, "2") == 0) {
                current_ui_state = UI_STATE_SETTINGS_AUTH;
            } else if (strcmp(input, "3") == 0) {
                current_ui_state = UI_STATE_CONTROL_AUTH;
            } else {
                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\nInvalid Selection!", 19, 100);
                HAL_Delay(1000);
            }
            ui_needs_refresh = 1;
            break;

        case UI_STATE_MONITORING:
            ui_needs_refresh = 1;
            break;

        case UI_STATE_SETTINGS_AUTH:
            if (strcmp(input, "1111") == 0) {
                current_ui_state = UI_STATE_SETTINGS_MENU;
            } else {
                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\n[ACCESS DENIED] Incorrect Password!", 37, 100);
                HAL_Delay(1200);
                current_ui_state = UI_STATE_MAIN_MENU;
            }
            ui_needs_refresh = 1;
            break;

        case UI_STATE_SETTINGS_MENU:
            if (strncmp(input, "set_temp ", 9) == 0) {
                target_temp = (float)atof(input + 9);
                snprintf(feedback, sizeof(feedback), "\r\n[UPDATED] Target set to %.1f C", target_temp);
                HAL_UART_Transmit(env_huart, (uint8_t*)feedback, strlen(feedback), 100);
                HAL_Delay(1000);
            }
            else if (strncmp(input, "set_time ", 9) == 0) {
                int hr = 0, min = 0;
                if (sscanf(input + 9, "%d:%d", &hr, &min) == 2 && hr >= 0 && hr < 24 && min >= 0 && min < 60) {
                    RTC_TimeTypeDef sTime = {0};
                    sTime.Hours = (uint8_t)hr;
                    sTime.Minutes = (uint8_t)min;
                    HAL_RTC_SetTime(env_hrtc, &sTime, RTC_FORMAT_BIN);
                    snprintf(feedback, sizeof(feedback), "\r\n[UPDATED] RTC Time set to %02d:%02d:00", hr, min);
                } else {
                    snprintf(feedback, sizeof(feedback), "\r\n[ERROR] Format constraint mismatch (hh:mm)");
                }
                HAL_UART_Transmit(env_huart, (uint8_t*)feedback, strlen(feedback), 100);
                HAL_Delay(1200);
            }
            else if (strncmp(input, "set_date ", 9) == 0) {
                int mo = 0, dy = 0;
                if (sscanf(input + 9, "%d/%d", &mo, &dy) == 2 && mo >= 1 && mo <= 12 && dy >= 1 && dy <= 31) {
                    RTC_DateTypeDef sDate = {0};
                    sDate.Month = (uint8_t)mo;
                    sDate.Date = (uint8_t)dy;
                    sDate.Year = 26; // Default operational execution offset context (2026)
                    HAL_RTC_SetDate(env_hrtc, &sDate, RTC_FORMAT_BIN);
                    snprintf(feedback, sizeof(feedback), "\r\n[UPDATED] RTC Date set to %02d/%02d/2026", mo, dy);
                } else {
                    snprintf(feedback, sizeof(feedback), "\r\n[ERROR] Format constraint mismatch (mm/dd)");
                }
                HAL_UART_Transmit(env_huart, (uint8_t*)feedback, strlen(feedback), 100);
                HAL_Delay(1200);
            }
            else {
                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\nUnknown Settings Parameter!", 29, 100);
                HAL_Delay(1000);
            }
            ui_needs_refresh = 1;
            break;

        case UI_STATE_CONTROL_AUTH:
            if (strcmp(input, "1111") == 0) {
                current_ui_state = UI_STATE_CONTROL_MENU;
            } else {
                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\n[ACCESS DENIED] Incorrect Password!", 37, 100);
                HAL_Delay(1200);
                current_ui_state = UI_STATE_MAIN_MENU;
            }
            ui_needs_refresh = 1;
            break;

        case UI_STATE_CONTROL_MENU:
            if (strcmp(input, "reset_sys") == 0) {
                is_system_locked = 0;
                fire_alarm_muted = 0;
                buffer_index = 0;

                HAL_GPIO_WritePin(FAN_GPIO_Port, FAN_Pin, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(HEATER_GPIO_Port, HEATER_Pin, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(SPRINKLER_1_GPIO_Port, SPRINKLER_1_Pin, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(SPRINKLER_2_GPIO_Port, SPRINKLER_2_Pin, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(BUZZER_GPIO_Port, BUZZER_Pin, GPIO_PIN_RESET);

                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\n[SUCCESS] Safety Interlocks Flushed.", 39, 100);
                HAL_Delay(1200);
            } else if (strcmp(input, "mute_alarm") == 0) {
                fire_alarm_muted = 1;
                HAL_GPIO_WritePin(BUZZER_GPIO_Port, BUZZER_Pin, GPIO_PIN_RESET);
                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\n[SUCCESS] Buzzer Signal Silenced.", 36, 100);
                HAL_Delay(1200);
            } else {
                HAL_UART_Transmit(env_huart, (uint8_t*)"\r\nUnknown Operational Directive!", 32, 100);
                HAL_Delay(1000);
            }
            ui_needs_refresh = 1;
            break;

        default:
            current_ui_state = UI_STATE_MAIN_MENU;
            ui_needs_refresh = 1;
            break;
    }
}

static void Add_Temperature_To_History(float new_temp) {
    temp_history[buffer_index] = new_temp;
    buffer_index = (buffer_index + 1) % MOVING_AVG_SAMPLES;
    if (total_samples_collected < MOVING_AVG_SAMPLES) {
        total_samples_collected++;
    }
}

static float Get_Average_Temperature(void) {
    float sum = 0.0f;
    for (int i = 0; i < total_samples_collected; i++) {
        sum += temp_history[i];
    }
    return (total_samples_collected > 0) ? (sum / (float)total_samples_collected) : 25.0f;
}

static void Control_Temperature_Actuators(float avg_temp) {
    float high_thresh = target_temp * (1.0f + tolerance_percent);
    float low_thresh  = target_temp * (1.0f - tolerance_percent);

    if (avg_temp > high_thresh) {
        HAL_GPIO_WritePin(FAN_GPIO_Port, FAN_Pin, GPIO_PIN_SET);
        HAL_GPIO_WritePin(HEATER_GPIO_Port, HEATER_Pin, GPIO_PIN_RESET);
    } else if (avg_temp < low_thresh) {
        HAL_GPIO_WritePin(FAN_GPIO_Port, FAN_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(HEATER_GPIO_Port, HEATER_Pin, GPIO_PIN_SET);
    } else {
        HAL_GPIO_WritePin(FAN_GPIO_Port, FAN_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(HEATER_GPIO_Port, HEATER_Pin, GPIO_PIN_RESET);
    }
}

static void Control_Fire_Safety(char *fire_status_msg, size_t msg_len) {
    uint8_t fire1 = (HAL_GPIO_ReadPin(FIRE_1_GPIO_Port, FIRE_1_Pin) == GPIO_PIN_SET);
    uint8_t fire2 = (HAL_GPIO_ReadPin(FIRE_2_GPIO_Port, FIRE_2_Pin) == GPIO_PIN_SET);
    uint32_t current_time = HAL_GetTick();

    if (fire1 || fire2) {
        last_fire_detected_time = current_time;
        is_system_locked = 1;
    }
    else if (is_system_locked && (current_time - last_fire_detected_time >= ALARM_LOCK_DURATION_MS)) {
        is_system_locked = 0;
        fire_alarm_muted = 0;
    }

    if (is_system_locked) {
        HAL_GPIO_WritePin(SPRINKLER_1_GPIO_Port, SPRINKLER_1_Pin, fire1 ? GPIO_PIN_SET : GPIO_PIN_RESET);
        HAL_GPIO_WritePin(SPRINKLER_2_GPIO_Port, SPRINKLER_2_Pin, fire2 ? GPIO_PIN_SET : GPIO_PIN_RESET);

        if (!fire_alarm_muted) {
            HAL_GPIO_TogglePin(BUZZER_GPIO_Port, BUZZER_Pin);
        } else {
            HAL_GPIO_WritePin(BUZZER_GPIO_Port, BUZZER_Pin, GPIO_PIN_RESET);
        }

        if (fire_status_msg != NULL && msg_len > 0) {
            snprintf(fire_status_msg, msg_len, "!!! DANGER !!!");
        }
    } else {
        HAL_GPIO_WritePin(SPRINKLER_1_GPIO_Port, SPRINKLER_1_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(SPRINKLER_2_GPIO_Port, SPRINKLER_2_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(BUZZER_GPIO_Port, BUZZER_Pin, GPIO_PIN_RESET);
        if (fire_status_msg != NULL && msg_len > 0) {
            snprintf(fire_status_msg, msg_len, "SAFE");
        }
    }
}
