#include "main.h"
#include <stdio.h>
#include <string.h>

ADC_HandleTypeDef hadc1;
UART_HandleTypeDef huart1;

uint32_t adcValue = 0;
uint32_t lastDisplayTick = 0;

uint8_t rxByte;
char rxBuffer[50];
uint8_t rxIndex = 0;
char messageFromBoard2[50] = "None";

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_ADC1_Init(void);
static void MX_USART1_UART_Init(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_ADC1_Init();
  MX_USART1_UART_Init();

  // فعال‌سازی وقفه دریافت از بورد ۲
  HAL_UART_Receive_IT(&huart1, &rxByte, 1);

  while (1)
  {
      // هر 500 میلی‌ثانیه مقدار ADC را می‌خواند و به بورد ۲ می‌فرستد
      if (HAL_GetTick() - lastDisplayTick >= 500)
      {
          lastDisplayTick = HAL_GetTick();

          HAL_ADC_Start(&hadc1);
          HAL_ADC_PollForConversion(&hadc1, 100);
          adcValue = HAL_ADC_GetValue(&hadc1);

          char adcPacket[20];
          snprintf(adcPacket, sizeof(adcPacket), "ADC=%lu\n", adcValue);
          HAL_UART_Transmit(&huart1, (uint8_t*)adcPacket, strlen(adcPacket), 100);
      }
  }
}

// کالبک دریافت دیتای چت/دستورات فرستاده شده از بورد ۲
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        if (rxByte == '\r' || rxByte == '\n')
        {
            if (rxIndex > 0)
            {
                rxBuffer[rxIndex] = '\0';
                if (rxBuffer[0] == '#')
                {
                    strncpy(messageFromBoard2, &rxBuffer[1], sizeof(messageFromBoard2) - 1);
                }
                rxIndex = 0;
                memset(rxBuffer, 0, sizeof(rxBuffer));
            }
        }
        else if (rxIndex < sizeof(rxBuffer) - 1)
        {
            rxBuffer[rxIndex++] = (char)rxByte;
        }
        HAL_UART_Receive_IT(&huart1, &rxByte, 1);
    }
}

