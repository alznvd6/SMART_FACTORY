void HUB_ReceiveHandler(uint8_t rx_char, uint8_t uart_id) {
    // 1. From Board #1 (Telemetry Packets)
    if (uart_id == 1) {[cite: 12]
        if (tel_packet_ready) return;[cite: 12]

        if (rx_char == '\n' || rx_char == '\r') {[cite: 12]
            if (tel_index > 0) {[cite: 12]
                tel_input[tel_index] = '\0';[cite: 12]
                tel_packet_ready = 1;       [cite: 12]
            }
        } else if (tel_index < (TEL_INPUT_MAX - 1)) {[cite: 12]
            tel_input[tel_index++] = (char)rx_char; [cite: 12]
        }
    }
    // 2. From PC Terminal (CLI User Input)
    else if (uart_id == 3) {[cite: 12]
        if (cli_line_ready) return;[cite: 12]

        if (rx_char == '\r' || rx_char == '\n') {[cite: 12]
            if (cli_index > 0) {[cite: 12]
                cli_input[cli_index] = '\0';[cite: 12]
                cli_line_ready = 1;         [cite: 12]
            }
        } else if (rx_char == '\b' || rx_char == 127) {[cite: 12]
            if (cli_index > 0) {[cite: 12]
                cli_index--;[cite: 12]
                cli_input[cli_index] = '\0';[cite: 12]
                Send_PC("\b \b");[cite: 12]
            }
        } else if (cli_index < (CLI_INPUT_MAX - 1)) {[cite: 12]
            cli_input[cli_index++] = (char)rx_char;  [cite: 12]

            if (current_state == UI_STATE_ENTER_PASSWORD) {
                Send_PC("*"); // Mask passwords
            } else {
                char echo[2] = { (char)rx_char, '\0' };[cite: 12]
                Send_PC(echo);[cite: 12]
            }
        }
    }
}

void HUB_Task(void) {
    uint32_t current_tick = HAL_GetTick();[cite: 12]

    // 1. Process Telemetry Packets
    if (tel_packet_ready) {[cite: 12]
        Process_Telemetry_Packet(tel_input);[cite: 12]
        tel_index = 0;                      [cite: 12]
        memset(tel_input, 0, TEL_INPUT_MAX);[cite: 12]
        tel_packet_ready = 0;                [cite: 12]

        // Only trigger a dynamic redraw during monitoring so we don't disrupt menus
        if (current_state == UI_STATE_MONITORING) {
            ui_needs_refresh = 1;
        }
    }

    // 2. Process User Command Input
    if (cli_line_ready) {[cite: 12]
        Process_CLI_Command(cli_input);[cite: 12]
        cli_index = 0;                 [cite: 12]
        memset(cli_input, 0, CLI_INPUT_MAX);[cite: 12]
        cli_line_ready = 0;            [cite: 12]
        ui_needs_refresh = 1; // Always redraw after a command input
    }

    // 3. Auto-wipe status feedback message on timer expire
    if (showing_feedback && (current_tick - feedback_start_tick >= FEEDBACK_DURATION_MS)) {[cite: 12]
        showing_feedback = 0;[cite: 12]
        memset(feedback_message, 0, sizeof(feedback_message));[cite: 12]
        ui_needs_refresh = 1;
    }

    // 4. Render UI strictly on event change requests
    if (ui_needs_refresh) {
        ui_needs_refresh = 0;
        Render_Terminal_UI();
    }
}

/* --- Private Parsing Engine --- */

static void Process_Telemetry_Packet(char *packet) {
    if (packet == NULL || packet[0] != '@') return;[cite: 12]

    char *token = strtok(packet, "|");[cite: 12]
    while (token != NULL) {
        if (strncmp(token, "@TIME=", 6) == 0 && strlen(token) >= 14) {[cite: 12]
            strncpy(telemetry_time, token + 6, 8);[cite: 12]
            telemetry_time[8] = '\0';[cite: 12]
        } else if (strncmp(token, "DATE=", 5) == 0 && strlen(token) >= 13) {[cite: 12]
            strncpy(telemetry_date, token + 5, 8);[cite: 12]
            telemetry_date[8] = '\0';[cite: 12]
        } else if (strncmp(token, "CUR=", 4) == 0) {[cite: 12]
            telemetry_cur_temp = Custom_Atof(token + 4);[cite: 12]
        } else if (strncmp(token, "AVG=", 4) == 0) {[cite: 12]
            telemetry_avg_temp = Custom_Atof(token + 4);[cite: 12]
        } else if (strncmp(token, "FIRE=", 5) == 0) {[cite: 12]
            telemetry_fire = atoi(token + 5);[cite: 12]
        } else if (strncmp(token, "LOCK=", 5) == 0) {[cite: 12]
            telemetry_lock = atoi(token + 5);[cite: 12]
        } else if (strncmp(token, "TARG=", 5) == 0) {[cite: 12]
            telemetry_target = Custom_Atof(token + 5);[cite: 12]
        }
        token = strtok(NULL, "|");[cite: 12]
    }
}

static void Process_CLI_Command(char *cmd) {
    switch (current_state) {
        case UI_STATE_MAIN_MENU:
            if (strcmp(cmd, "1") == 0) {
                current_state = UI_STATE_MONITORING;
            } else if (strcmp(cmd, "2") == 0) {
                current_state = UI_STATE_ENTER_PASSWORD;
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Invalid Option. Choose 1 or 2.");
                feedback_start_tick = HAL_GetTick();
                showing_feedback = 1;
            }
            break;

        case UI_STATE_MONITORING:
            if (strcmp(cmd, "0") == 0) {
                current_state = UI_STATE_MAIN_MENU;
            } else {
                // If they press any other key inside monitoring, let's treat it as a manual layout update!
                ui_needs_refresh = 1;
            }
            break;

        case UI_STATE_ENTER_PASSWORD:
            if (strcmp(cmd, ADMIN_PASSWORD) == 0) {[cite: 12]
                current_state = UI_STATE_ADMIN_MENU;[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "Log-in Success!");
            } else {
                current_state = UI_STATE_MAIN_MENU;
                snprintf(feedback_message, sizeof(feedback_message), "Invalid Password! Denied.");
            }
            feedback_start_tick = HAL_GetTick();
            showing_feedback = 1;
            break;

        case UI_STATE_ADMIN_MENU:
            if (strcmp(cmd, "1") == 0) {[cite: 12]
                current_state = UI_STATE_SET_TEMP;[cite: 12]
            } else if (strcmp(cmd, "2") == 0) {[cite: 12]
                current_state = UI_STATE_SET_TIME;[cite: 12]
            } else if (strcmp(cmd, "3") == 0) {[cite: 12]
                current_state = UI_STATE_SET_DATE;[cite: 12]
            } else if (strcmp(cmd, "4") == 0) {[cite: 12]
                HAL_UART_Transmit(huart_env, (uint8_t*)"reset_sys\r\n", 11, 100);[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "System Reset Command Sent.");[cite: 12]
                feedback_start_tick = HAL_GetTick();[cite: 12]
                showing_feedback = 1;[cite: 12]
            } else if (strcmp(cmd, "5") == 0) {[cite: 12]
                HAL_UART_Transmit(huart_env, (uint8_t*)"mute_alarm\r\n", 12, 100);[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "Alarm Audio Mute Sent.");[cite: 12]
                feedback_start_tick = HAL_GetTick();[cite: 12]
                showing_feedback = 1;[cite: 12]
            } else if (strcmp(cmd, "6") == 0) {[cite: 12]
                current_state = UI_STATE_MAIN_MENU; // Logout goes back to main screen
                snprintf(feedback_message, sizeof(feedback_message), "Logged Out.");[cite: 12]
                feedback_start_tick = HAL_GetTick();[cite: 12]
                showing_feedback = 1;[cite: 12]
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Invalid Option.");[cite: 12]
                feedback_start_tick = HAL_GetTick();[cite: 12]
                showing_feedback = 1;[cite: 12]
            }
            break;

        case UI_STATE_SET_TEMP: {
            char tx_cmd[32];[cite: 12]
            snprintf(tx_cmd, sizeof(tx_cmd), "set_temp %s\r\n", cmd);[cite: 12]
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);[cite: 12]
            snprintf(feedback_message, sizeof(feedback_message), "Target Temp updated: %s C", cmd);[cite: 12]
            feedback_start_tick = HAL_GetTick();[cite: 12]
            showing_feedback = 1;[cite: 12]
            current_state = UI_STATE_ADMIN_MENU;[cite: 12]
            break;
        }

        case UI_STATE_SET_TIME: {
            char tx_cmd[32];[cite: 12]
            snprintf(tx_cmd, sizeof(tx_cmd), "set_time %s\r\n", cmd);[cite: 12]
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);[cite: 12]
            snprintf(feedback_message, sizeof(feedback_message), "System Time updated: %s", cmd);[cite: 12]
            feedback_start_tick = HAL_GetTick();[cite: 12]
            showing_feedback = 1;[cite: 12]
            current_state = UI_STATE_ADMIN_MENU;[cite: 12]
            break;
        }

        case UI_STATE_SET_DATE: {
            char tx_cmd[32];[cite: 12]
            snprintf(tx_cmd, sizeof(tx_cmd), "set_date %s\r\n", cmd);[cite: 12]
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100);[cite: 12]
            snprintf(feedback_message, sizeof(feedback_message), "System Date updated: %s", cmd);[cite: 12]
            feedback_start_tick = HAL_GetTick();[cite: 12]
            showing_feedback = 1;[cite: 12]
            current_state = UI_STATE_ADMIN_MENU;[cite: 12]
            break;
        }
    }
}

