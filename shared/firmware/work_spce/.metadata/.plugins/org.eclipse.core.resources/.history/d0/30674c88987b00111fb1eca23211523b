/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  // Enable USART1 Interrupt Priority (Optional, already handled by NVIC in Cube)
  HAL_NVIC_SetPriority(USART1_IRQn, 0, 0);
  HAL_NVIC_EnableIRQ(USART1_IRQn);

  char clearScreen[] = "\033[2J\033[H";
  HAL_UART_Transmit(&huart1, (uint8_t*)clearScreen, strlen(clearScreen), HAL_MAX_DELAY);
  HAL_UART_Receive_IT(&huart1, &rxByte, 1);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
    while (1)
    {
      if (HAL_GetTick() - lastDisplayTick >= 500)
      {
          lastDisplayTick = HAL_GetTick();
          printLocalConsole();
      }

      if (lineReadyFromTerminal == 1)
      {
          char txPacket[65];

          // Parse input commands entered by the operator into Terminal 2
          if (strcmp(rxBuffer, "1") == 0)
          {
              // Transmit background command packet to switch LED on Board 1
              snprintf(txPacket, sizeof(txPacket), "#CMD_LED_ON\n");
          }
          else if (strcmp(rxBuffer, "0") == 0)
          {
              // Transmit background command packet to switch LED off Board 1
              snprintf(txPacket, sizeof(txPacket), "#CMD_LED_OFF\n");
          }
          else
          {
              // Treat anything else as a standard chat string message
              snprintf(txPacket, sizeof(txPacket), "#%s\n", rxBuffer);
          }

          // Push data packet down the wire
          HAL_UART_Transmit(&huart1, (uint8_t*)txPacket, strlen(txPacket), 100);

          // Reset tracking parameters for the next command string
          memset(rxBuffer, 0, sizeof(rxBuffer));
          rxIndex = 0;
          lineReadyFromTerminal = 0;
          printLocalConsole();
      }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

