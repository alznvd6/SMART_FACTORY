/**
 * @brief Rx Transfer completed callbacks in non-blocking Interrupt Mode
 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    // Channel A: Telemetry stream incoming from Board #1 on UART1
    if (huart->Instance == USART1)
    {
        // Pass received character to the handler (Source ID: 1)
        HUB_ReceiveHandler(rxByte1, 1);

        // Re-arm interrupt for next byte
        HAL_UART_Receive_IT(&huart1, &rxByte1, 1);
    }
    // Channel B: User keystrokes from Local PC Virtual Terminal on UART3
    else if (huart->Instance == USART3)
    {
        // Pass received character to the handler (Source ID: 3)
        HUB_ReceiveHandler(rxByte3, 3);

        // Re-arm interrupt for next byte
        HAL_UART_Receive_IT(&huart3, &rxByte3, 1);
    }
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();

  /* USER CODE BEGIN 2 */
  // Initialize Central Hub
  HUB_Init(&huart1, &huart3, &huart2);

  // Start listening on both UART channels via non-blocking interrupts
  HAL_UART_Receive_IT(&huart1, &rxByte1, 1);
  HAL_UART_Receive_IT(&huart3, &rxByte3, 1);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // Non-blocking UI task handling updates, terminal input, and feedback timers
      HUB_Task();

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

