#include "environment.h"
#include <stdio.h>
#include <string.h>

// Private pointers to peripherals
static ADC_HandleTypeDef *env_hadc;
static UART_HandleTypeDef *env_huart;

// Initialize the module with handles from main.c
void ENV_Init(ADC_HandleTypeDef *hadc_ptr, UART_HandleTypeDef *huart_ptr) {
    env_hadc = hadc_ptr;
    env_huart = huart_ptr;
}

// Read ADC and send to UART
void ENV_Task(void) {
    uint32_t adc_value = 0;
    char uart_buffer[50];

    // 1. Start ADC Conversion
    HAL_ADC_Start(env_hadc);

    // 2. Wait for conversion to complete (Timeout: 10ms)
    if (HAL_ADC_PollForConversion(env_hadc, 10) == HAL_OK) {
        // 3. Get the 12-bit digital value (0 - 4095)
        adc_value = HAL_ADC_GetValue(env_hadc);
    }

    // 4. Stop ADC
    HAL_ADC_Stop(env_hadc);

    // 5. Format string and send to Proteus Virtual Terminal
    snprintf(uart_buffer, sizeof(uart_buffer), "Analog Reading: %lu\r\n", adc_value);
    HAL_UART_Transmit(env_huart, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
}
