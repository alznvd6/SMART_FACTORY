#ifndef HUB_H
#define HUB_H

#include "stm32f1xx_hal.h"
#include <stdint.h>

/* Data structure to hold Board #1 Telemetry */
typedef struct {
    uint8_t time_hh;
    uint8_t time_mm;
    uint8_t time_ss;

    uint8_t date_yy;
    uint8_t date_mm;
    uint8_t date_dd;

    float current_temp;
    float avg_temp;
    float target_temp;

    uint8_t fire_triggered;
    uint8_t system_locked;
} Factory_Telemetry_t;

/* Public API */
void HUB_Init(UART_HandleTypeDef *huart_env_ptr, UART_HandleTypeDef *huart_pc_ptr);
void HUB_ReceiveHandler(uint8_t rx_char, uint8_t uart_id);
void HUB_Task(void);

/* Global access declaration */
extern Factory_Telemetry_t latest_factory_data;

#endif /* HUB_H */
