static void Send_PC(const char *str) {
    // Up to 1000ms timeout to ensure the buffer is fully sent before exit
    HAL_UART_Transmit(huart_pc, (uint8_t*)str, strlen(str), 1000);
}

static float Custom_Atof(const char *p) {
    while (*p == ' ') p++;
    float val = 0.0f;
    float sign = 1.0f;
    if (*p == '-') { sign = -1.0f; p++; }
    else if (*p == '+') { p++; }
    while (*p >= '0' && *p <= '9') {
        val = val * 10.0f + (*p - '0');
        p++;
    }
    if (*p == '.') {
        p++;
        float divisor = 10.0f;
        while (*p >= '0' && *p <= '9') {
            val += (*p - '0') / divisor;
            divisor *= 10.0f;
            p++;
        }
    }
    return val * sign;
}
