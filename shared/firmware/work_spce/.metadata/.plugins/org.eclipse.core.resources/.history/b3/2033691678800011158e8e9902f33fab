  /* USER CODE BEGIN 2 */
  /* USER CODE BEGIN 2 */
    char clearScreen[] = "\033[2J\033[H";
    HAL_UART_Transmit(&huart2, (uint8_t*)clearScreen, strlen(clearScreen), HAL_MAX_DELAY);

    // Clear the screen of your new local Virtual Terminal on startup
    HAL_UART_Transmit(&huart3, (uint8_t*)clearScreen, strlen(clearScreen), HAL_MAX_DELAY);

