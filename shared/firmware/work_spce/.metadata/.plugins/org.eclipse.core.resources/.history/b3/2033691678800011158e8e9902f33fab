void HUB_ReceiveHandler(uint8_t rx_char) {
    // If a command is currently processing in the background loop, skip inputs
    if (hub_cmd_ready) {
        return;
    }

    // Echo masking: Hide password characters with asterisks
    if (current_hub_state == HUB_STATE_ADMIN_AUTH) {
        char asterisk = '*';
        if (rx_char != '\r' && rx_char != '\b' && rx_char != 127) {
            HAL_UART_Transmit(&huart3, (uint8_t*)&asterisk, 1, 10);
        }
    } else {
        // Normal text echo feedback back to Virtual Terminal
        if (rx_char != '\r' && rx_char != '\b' && rx_char != 127) {
            HAL_UART_Transmit(&huart3, &rx_char, 1, 10);
        }
    }

    // Process input on carriage return
    if (rx_char == '\r') {
        hub_rx_buffer[hub_rx_index] = '\0';
        hub_cmd_ready = 1;
    }
    // Handle manual text backspaces inside Proteus nicely
    else if (rx_char == '\b' || rx_char == 127) {
        if (hub_rx_index > 0) {
            hub_rx_index--;
            hub_rx_buffer[hub_rx_index] = '\0';
            char *backspace_seq = "\b \b";
            HAL_UART_Transmit(&huart3, (uint8_t*)backspace_seq, 3, 10);
        }
    }
    // Store non-control characters into buffer
    else if (hub_rx_index < (HUB_RX_BUF_SIZE - 1)) {
        hub_rx_buffer[hub_rx_index++] = (char)rx_char;
    }
}

/**
 * @brief Renders the visual menu interface directly to USART3's Virtual Terminal
 */
void HUB_Display_Menu(void) {
    char menuBuffer[400];

    // Send an ANSI clear terminal screen escape sequence
    HAL_UART_Transmit(&huart3, (uint8_t*)"\033[2J\033[H", 6, 100);

    switch (current_hub_state) {
        case HUB_STATE_MAIN_MENU:
            snprintf(menuBuffer, sizeof(menuBuffer),
                     "=========================================\r\n"
                     "      BOARD #2: CENTRAL CONTROL HUB      \r\n"
                     "=========================================\r\n"
                     " > 1. View Live Factory Feed\r\n"
                     " > 2. Enter Privileged Administration\r\n"
                     "=========================================\r\n"
                     "Enter Selection: ");
            break;

        case HUB_STATE_MONITOR_VIEW:
            snprintf(menuBuffer, sizeof(menuBuffer),
                     "=========================================\r\n"
                     "       LIVE HUB DATA MONITOR VIEW        \r\n"
                     "=========================================\r\n"
                     " * Current Temperature : %s C\r\n"
                     " * Moving Average Temp : %s C\r\n"
                     " * Fire Safety Status  : [%s]\r\n"
                     " * System Interlock    : %s\r\n"
                     "=========================================\r\n"
