#include "hub.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>

#define RX_BUFFER_SIZE 256

/* --- Private Variables --- */
static UART_HandleTypeDef *hub_huart;
Factory_Telemetry_t latest_factory_data = {0};

static char rx_buffer[RX_BUFFER_SIZE];
static volatile uint8_t rx_index = 0;
static volatile uint8_t packet_ready = 0;

/* --- Private Helper --- */
static void Parse_Telemetry_Packet(char *packet);

/**
 * @brief Initialize the Hub module
 */
void HUB_Init(UART_HandleTypeDef *huart_ptr) {
    hub_huart = huart_ptr;
    memset(rx_buffer, 0, RX_BUFFER_SIZE);
    rx_index = 0;
    packet_ready = 0;
}

