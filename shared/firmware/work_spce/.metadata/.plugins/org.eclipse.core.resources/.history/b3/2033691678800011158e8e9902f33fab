    hub_needs_refresh = 1;
    /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)

  {
	  uint32_t current_tick = HAL_GetTick();

	        // 1. Asynchronously refresh standard desktop console over USART2
	        if (current_tick - lastDisplayTick >= 1500)
	        {
	            lastDisplayTick = current_tick;
	            printRemoteConsole();

	            // If user is inside the monitor screen, update the VT3 screen with new values
	            if (current_hub_state == HUB_STATE_MONITOR_VIEW) {
	                hub_needs_refresh = 1;
	            }
	        }

	        // 2. Process complete command strings collected from USART3
	        if (hub_cmd_ready) {
	            HUB_Process_Input(hub_rx_buffer);

	            hub_rx_index = 0;
	            memset(hub_rx_buffer, 0, HUB_RX_BUF_SIZE);
	            hub_cmd_ready = 0;
	        }

	        // 3. Redraw menu UI panel if a flag condition changed state
	        if (hub_needs_refresh) {
	            HUB_Display_Menu();
	            hub_needs_refresh = 0;
	        }

