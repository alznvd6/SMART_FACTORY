/* Define the global variable declared in hub.h */
Factory_Telemetry_t latest_factory_data;

/* --- Hardware Interfaces --- */
static UART_HandleTypeDef *huart_env;  // UART1: Connected to Board #1[cite: 12]
static UART_HandleTypeDef *huart_pc;   // UART3: Connected to PC CLI Terminal[cite: 12]

/* --- UI State Management --- */
typedef enum {
    UI_STATE_MONITOR = 0,
    UI_STATE_ENTER_PASSWORD,
    UI_STATE_ADMIN_MENU,
    UI_STATE_SET_TEMP,
    UI_STATE_SET_TIME,
    UI_STATE_SET_DATE
} UI_State_t;

static UI_State_t current_state = UI_STATE_MONITOR;

/* --- Buffered Data from Board #1 Telemetry --- */
static char  telemetry_time[9]  = "00:00:00"; //[cite: 12]
static char  telemetry_date[9]  = "00-00-00"; //[cite: 12]
static float telemetry_cur_temp = 0.0f;       //[cite: 12]
static float telemetry_avg_temp = 0.0f;       //[cite: 12]
static float telemetry_target   = 25.0f;      //[cite: 12]
static int   telemetry_fire     = 0;          //[cite: 12]
static int   telemetry_lock     = 0;          //[cite: 12]

/* --- Local Input Buffers --- */
#define CLI_INPUT_MAX           32
static char             cli_input[CLI_INPUT_MAX]; //[cite: 12]
static volatile uint8_t cli_index = 0;            //[cite: 12]
static volatile uint8_t cli_line_ready = 0;       //[cite: 12]

#define TEL_INPUT_MAX           128
static char             tel_input[TEL_INPUT_MAX]; //[cite: 12]
static volatile uint8_t tel_index = 0;            //[cite: 12]
static volatile uint8_t tel_packet_ready = 0;     //[cite: 12]

/* --- UI Force Redraw Flag --- */
static uint8_t ui_needs_refresh = 1;

/* --- Administrative Access --- */
#define ADMIN_PASSWORD          "admin123" //[cite: 12]
static char    entered_password[16] = ""; //[cite: 12]

/* --- Non-Blocking Feedback Timer --- */
static char     feedback_message[64] = ""; //[cite: 12]
static uint32_t feedback_start_tick = 0;   //[cite: 12]
static uint8_t  showing_feedback = 0;      //[cite: 12]

#define FEEDBACK_DURATION_MS    1500 //[cite: 12]
#define UI_REFRESH_INTERVAL_MS  2000 // Slow down heartbeat refresh rate to prevent spamming

/* --- Private Function Prototypes --- */
static void Process_Telemetry_Packet(char *packet); //[cite: 12]
static void Process_CLI_Command(char *cmd);         //[cite: 12]
static void Render_Terminal_UI(void);               //[cite: 12]
static void Clear_Screen(void);                     //[cite: 12]
static void Send_PC(const char *str);               //[cite: 12]
static float Custom_Atof(const char *p);            //[cite: 12]

/* --- Core Public API --- */

/**
 * @brief Initializes the Central Hub
 */
void HUB_Init(UART_HandleTypeDef *huart_env_ptr, UART_HandleTypeDef *huart_pc_ptr) {
    huart_env = huart_env_ptr; //[cite: 12]
    huart_pc  = huart_pc_ptr;  //[cite: 12]

    memset(cli_input, 0, CLI_INPUT_MAX); //[cite: 12]
    cli_index = 0;                       //[cite: 12]
    cli_line_ready = 0;                  //[cite: 12]

    memset(tel_input, 0, TEL_INPUT_MAX); //[cite: 12]
    tel_index = 0;                       //[cite: 12]
    tel_packet_ready = 0;                //[cite: 12]

    memset(&latest_factory_data, 0, sizeof(latest_factory_data));

    Clear_Screen();
    Send_PC("HUB CONTROLLER INITIALIZED. WAITING FOR DATA...\r\n");
    ui_needs_refresh = 1;
}

/**
 * @brief Handle incoming characters from ISR context
 */
void HUB_ReceiveHandler(uint8_t rx_char, uint8_t uart_id) {
    // 1. From Board #1 (Telemetry)
    if (uart_id == 1) { //[cite: 12]
        if (tel_packet_ready) return; //[cite: 12]

        if (rx_char == '\n' || rx_char == '\r') { //[cite: 12]
            if (tel_index > 0) { //[cite: 12]
                tel_input[tel_index] = '\0'; //[cite: 12]
                tel_packet_ready = 1;        //[cite: 12]
            }
        } else if (tel_index < (TEL_INPUT_MAX - 1)) { //[cite: 12]
            tel_input[tel_index++] = (char)rx_char;  //[cite: 12]
        }
    }
    // 2. From PC Terminal (Command Input)
    else if (uart_id == 3) { //[cite: 12]
        if (cli_line_ready) return; //[cite: 12]

        if (rx_char == '\r' || rx_char == '\n') { //[cite: 12]
            if (cli_index > 0) { //[cite: 12]
                cli_input[cli_index] = '\0'; //[cite: 12]
                cli_line_ready = 1;          //[cite: 12]
            }
        } else if (rx_char == '\b' || rx_char == 127) { //[cite: 12]
            if (cli_index > 0) { //[cite: 12]
                cli_index--; //[cite: 12]
                cli_input[cli_index] = '\0'; //[cite: 12]
                Send_PC("\b \b"); //[cite: 12]
            }
        } else if (cli_index < (CLI_INPUT_MAX - 1)) { //[cite: 12]
            cli_input[cli_index++] = (char)rx_char;   //[cite: 12]

            if (current_state == UI_STATE_ENTER_PASSWORD) {
                Send_PC("*");
            } else {
                char echo[2] = { (char)rx_char, '\0' }; //[cite: 12]
                Send_PC(echo); //[cite: 12]
            }
        }
    }
}

/**
 * @brief Main execution task scheduled in the background loop
 */
void HUB_Task(void) {
    static uint32_t last_ui_tick = 0;
    uint32_t current_tick = HAL_GetTick(); //[cite: 12]

    // 1. Parse Telemetry incoming from Board #1
    if (tel_packet_ready) { //[cite: 12]
        Process_Telemetry_Packet(tel_input); //[cite: 12]
        tel_index = 0;                       //[cite: 12]
        memset(tel_input, 0, TEL_INPUT_MAX); //[cite: 12]
        tel_packet_ready = 0;                //[cite: 12]
        ui_needs_refresh = 1;
    }

    // 2. Parse Commands typed into PC Terminal
    if (cli_line_ready) { //[cite: 12]
        Process_CLI_Command(cli_input); //[cite: 12]
        cli_index = 0;                  //[cite: 12]
        memset(cli_input, 0, CLI_INPUT_MAX); //[cite: 12]
        cli_line_ready = 0;             //[cite: 12]
        ui_needs_refresh = 1;
    }

    // 3. Clear Feedback Message after expiration timer finishes
    if (showing_feedback && (current_tick - feedback_start_tick >= FEEDBACK_DURATION_MS)) { //[cite: 12]
        showing_feedback = 0; //[cite: 12]
        memset(feedback_message, 0, sizeof(feedback_message)); //[cite: 12]
        ui_needs_refresh = 1;
    }

    // 4. Update CLI Terminal View (either triggered on-event or periodically)
    if (ui_needs_refresh || (current_tick - last_ui_tick >= UI_REFRESH_INTERVAL_MS)) {
        last_ui_tick = current_tick;
        ui_needs_refresh = 0;
        Render_Terminal_UI();
    }
}

/* --- Private Parsing Engine --- */

static void Process_Telemetry_Packet(char *packet) {
    if (packet == NULL || packet[0] != '@') return; //[cite: 12]

    char *token = strtok(packet, "|"); //[cite: 12]
    while (token != NULL) {
        if (strncmp(token, "@TIME=", 6) == 0 && strlen(token) >= 14) { //[cite: 12]
            strncpy(telemetry_time, token + 6, 8); //[cite: 12]
            telemetry_time[8] = '\0'; //[cite: 12]

            int hh = 0, mm = 0, ss = 0;
            if (sscanf(telemetry_time, "%d:%d:%d", &hh, &mm, &ss) == 3) {
                latest_factory_data.time_hh = (uint8_t)hh;
                latest_factory_data.time_mm = (uint8_t)mm;
                latest_factory_data.time_ss = (uint8_t)ss;
            }
        } else if (strncmp(token, "DATE=", 5) == 0 && strlen(token) >= 13) { //[cite: 12]
            strncpy(telemetry_date, token + 5, 8); //[cite: 12]
            telemetry_date[8] = '\0'; //[cite: 12]

            int yy = 0, mn = 0, dd = 0;
            if (sscanf(telemetry_date, "%d-%d-%d", &yy, &mn, &dd) == 3) {
                latest_factory_data.date_yy = (uint8_t)yy;
                latest_factory_data.date_mm = (uint8_t)mn;
                latest_factory_data.date_dd = (uint8_t)dd;
            }
        } else if (strncmp(token, "CUR=", 4) == 0) { //[cite: 12]
            telemetry_cur_temp = Custom_Atof(token + 4); //[cite: 12]
            latest_factory_data.current_temp = telemetry_cur_temp;
        } else if (strncmp(token, "AVG=", 4) == 0) { //[cite: 12]
            telemetry_avg_temp = Custom_Atof(token + 4); //[cite: 12]
            latest_factory_data.avg_temp = telemetry_avg_temp;
        } else if (strncmp(token, "FIRE=", 5) == 0) { //[cite: 12]
            telemetry_fire = atoi(token + 5); //[cite: 12]
            latest_factory_data.fire_triggered = (uint8_t)telemetry_fire;
        } else if (strncmp(token, "LOCK=", 5) == 0) { //[cite: 12]
            telemetry_lock = atoi(token + 5); //[cite: 12]
            latest_factory_data.system_locked = (uint8_t)telemetry_lock;
        } else if (strncmp(token, "TARG=", 5) == 0) { //[cite: 12]
            telemetry_target = Custom_Atof(token + 5); //[cite: 12]
            latest_factory_data.target_temp = telemetry_target;
        }
        token = strtok(NULL, "|"); //[cite: 12]
    }
}

static void Process_CLI_Command(char *cmd) {
    switch (current_state) {
        case UI_STATE_MONITOR:
            if (strcmp(cmd, "admin") == 0) { //[cite: 12]
                current_state = UI_STATE_ENTER_PASSWORD; //[cite: 12]
                memset(entered_password, 0, sizeof(entered_password)); //[cite: 12]
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Unknown command. Type 'admin' to log in."); //[cite: 12]
                feedback_start_tick = HAL_GetTick(); //[cite: 12]
                showing_feedback = 1; //[cite: 12]
            }
            break;

        case UI_STATE_ENTER_PASSWORD:
            if (strcmp(cmd, ADMIN_PASSWORD) == 0) { //[cite: 12]
                current_state = UI_STATE_ADMIN_MENU; //[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "Access Granted! Welcome Admin."); //[cite: 12]
            } else {
                current_state = UI_STATE_MONITOR; //[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "Access Denied. Incorrect Password."); //[cite: 12]
            }
            feedback_start_tick = HAL_GetTick(); //[cite: 12]
            showing_feedback = 1; //[cite: 12]
            break;

        case UI_STATE_ADMIN_MENU:
            if (strcmp(cmd, "1") == 0) { //[cite: 12]
                current_state = UI_STATE_SET_TEMP; //[cite: 12]
            } else if (strcmp(cmd, "2") == 0) { //[cite: 12]
                current_state = UI_STATE_SET_TIME; //[cite: 12]
            } else if (strcmp(cmd, "3") == 0) { //[cite: 12]
                current_state = UI_STATE_SET_DATE; //[cite: 12]
            } else if (strcmp(cmd, "4") == 0) { //[cite: 12]
                HAL_UART_Transmit(huart_env, (uint8_t*)"reset_sys\r\n", 11, 100); //[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "System Alarm Interlocks Reset Sent."); //[cite: 12]
                feedback_start_tick = HAL_GetTick(); //[cite: 12]
                showing_feedback = 1; //[cite: 12]
            } else if (strcmp(cmd, "5") == 0) { //[cite: 12]
                HAL_UART_Transmit(huart_env, (uint8_t*)"mute_alarm\r\n", 12, 100); //[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "Alarm Audio Mute Command Sent."); //[cite: 12]
                feedback_start_tick = HAL_GetTick(); //[cite: 12]
                showing_feedback = 1; //[cite: 12]
            } else if (strcmp(cmd, "6") == 0) { //[cite: 12]
                current_state = UI_STATE_MONITOR; //[cite: 12]
                snprintf(feedback_message, sizeof(feedback_message), "Logged Out."); //[cite: 12]
                feedback_start_tick = HAL_GetTick(); //[cite: 12]
                showing_feedback = 1; //[cite: 12]
            } else {
                snprintf(feedback_message, sizeof(feedback_message), "Invalid Option."); //[cite: 12]
                feedback_start_tick = HAL_GetTick(); //[cite: 12]
                showing_feedback = 1; //[cite: 12]
            }
            break;

        case UI_STATE_SET_TEMP: {
            char tx_cmd[32]; //[cite: 12]
            snprintf(tx_cmd, sizeof(tx_cmd), "set_temp %s\r\n", cmd); //[cite: 12]
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100); //[cite: 12]

            snprintf(feedback_message, sizeof(feedback_message), "Target Temp updated to: %s C", cmd); //[cite: 12]
            feedback_start_tick = HAL_GetTick(); //[cite: 12]
            showing_feedback = 1; //[cite: 12]
            current_state = UI_STATE_ADMIN_MENU; //[cite: 12]
            break;
        }

        case UI_STATE_SET_TIME: {
            char tx_cmd[32]; //[cite: 12]
            snprintf(tx_cmd, sizeof(tx_cmd), "set_time %s\r\n", cmd); //[cite: 12]
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100); //[cite: 12]

            snprintf(feedback_message, sizeof(feedback_message), "System Time updated to: %s", cmd); //[cite: 12]
            feedback_start_tick = HAL_GetTick(); //[cite: 12]
            showing_feedback = 1; //[cite: 12]
            current_state = UI_STATE_ADMIN_MENU; //[cite: 12]
            break;
        }

        case UI_STATE_SET_DATE: {
            char tx_cmd[32]; //[cite: 12]
            snprintf(tx_cmd, sizeof(tx_cmd), "set_date %s\r\n", cmd); //[cite: 12]
            HAL_UART_Transmit(huart_env, (uint8_t*)tx_cmd, strlen(tx_cmd), 100); //[cite: 12]

            snprintf(feedback_message, sizeof(feedback_message), "System Date updated to: %s", cmd); //[cite: 12]
            feedback_start_tick = HAL_GetTick(); //[cite: 12]
            showing_feedback = 1; //[cite: 12]
            current_state = UI_STATE_ADMIN_MENU; //[cite: 12]
            break;
        }
    }
}

/* --- CLI Drawing Engine --- */

/**
 * @brief Renders the completely flat, scrolling UI compatible with basic virtual terminals
 */
static void Render_Terminal_UI(void) {
    char frame[1024];
    char dynamic_body[512] = "";

    // Clear previous view in a standard compatible way
    Clear_Screen();

    // Standard text printing (No ESC colors or cursor coordinates)
    snprintf(frame, sizeof(frame),
             "====================================================\r\n"
             "        SMART COLDROOM DISTRIBUTED DASHBOARD        \r\n"
             "====================================================\r\n"
             "  Time: %s  |  Date: %s\r\n"
             "----------------------------------------------------\r\n"
             "  Current Temp : %.1f C\r\n"
             "  Average Temp : %.1f C\r\n"
             "  Target Temp  : %.1f C\r\n"
             "  Status       : %s\r\n"
             "  Safety Lock  : %s\r\n"
             "====================================================\r\n",
             telemetry_time, telemetry_date,
             telemetry_cur_temp, telemetry_avg_temp, telemetry_target,
             telemetry_fire ? "!!! FIRE DETECTED !!!" : "SECURE (NORMAL)",
             telemetry_lock ? "ACTIVE LOCKED (SAFETY SHUTDOWN)" : "OFF (SYSTEM ACTIVE)");

    // Append dynamic menu bodies based on user CLI state
    switch (current_state) {
        case UI_STATE_MONITOR:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Type 'admin' to log in to settings panel.\r\n"
                     "\r\n"
                     "Console> ");
            break;

        case UI_STATE_ENTER_PASSWORD:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  ENTER ADMIN PASSWORD:\r\n"
                     "  Password: ");
            break;

        case UI_STATE_ADMIN_MENU:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "  ADMIN CONTROL CENTER\r\n"
                     "  [1] Set Target Temperature\r\n"
                     "  [2] Sync System Time (Format: HH:MM:SS)\r\n"
                     "  [3] Sync System Date (Format: YY:MM:DD)\r\n"
                     "  [4] Reset System Interlocks / Alarm\r\n"
                     "  [5] Mute Alarm Buzzer\r\n"
                     "  [6] Logout\r\n"
                     "----------------------------------------------------\r\n"
                     "Admin Option> ");
            break;

        case UI_STATE_SET_TEMP:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Enter new Target Temperature (Format: XX.X): ");
            break;

        case UI_STATE_SET_TIME:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Enter System Time (Format: HH:MM:SS): ");
            break;

        case UI_STATE_SET_DATE:
            snprintf(dynamic_body, sizeof(dynamic_body),
                     "\r\n"
                     "  Enter System Date (Format: YY:MM:DD): ");
            break;
    }

    strcat(frame, dynamic_body);

    if (showing_feedback) {
        char status_footer[128];
        snprintf(status_footer, sizeof(status_footer), "\r\n[STATUS: %s]", feedback_message);
        strcat(frame, status_footer);
    }

    Send_PC(frame);
}

/* --- Support Utilities --- */

/**
 * @brief Standard cross-platform terminal scrolling clear
 */
static void Clear_Screen(void) {
    // Send 15 line breaks to push previous prints out of view reliably
    Send_PC("\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n");
}

static void Send_PC(const char *str) {
    HAL_UART_Transmit(huart_pc, (uint8_t*)str, strlen(str), 1000);
}

static float Custom_Atof(const char *p) {
    while (*p == ' ') p++;
    float val = 0.0f;
    float sign = 1.0f;
    if (*p == '-') { sign = -1.0f; p++; }
    else if (*p == '+') { p++; }
    while (*p >= '0' && *p <= '9') {
        val = val * 10.0f + (*p - '0');
        p++;
    }
    if (*p == '.') {
        p++;
        float divisor = 10.0f;
        while (*p >= '0' && *p <= '9') {
            val += (*p - '0') / divisor;
            divisor *= 10.0f;
            p++;
        }
    }
    return val * sign;
}
