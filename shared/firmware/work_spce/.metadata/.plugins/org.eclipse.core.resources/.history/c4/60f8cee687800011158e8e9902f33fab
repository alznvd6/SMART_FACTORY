/**
 * @brief Main loop background task for Board #2
 */
void HUB_Task(void) {
    if (packet_ready) {
        // 1. Parse the incoming string
        Parse_Telemetry_Packet(rx_buffer);

        // 2. Clear buffer and reset for the next packet
        memset(rx_buffer, 0, RX_BUFFER_SIZE);
        rx_index = 0;
        packet_ready = 0;

        // 3. (Optional) Re-enable UART interrupt here if needed,
        // depending on how you structured your HAL_UART_Receive_IT
    }
}

/**
 * @brief Extracts the values from the Board #1 telemetry string
 * Expected format: @TIME=hh:mm:ss|DATE=yy-mm-dd|CUR=xx.x|AVG=xx.x|FIRE=x|LOCK=x|TARG=xx.x
 */
static void Parse_Telemetry_Packet(char *packet) {
    // Quick validation to ensure it's our telemetry packet
    if (packet[0] != '@') return;

    /*
     * Using sscanf to slice up the formatted string.
     * Note: Make sure '-u _scanf_float' is enabled in your GCC linker settings
     * so sscanf can successfully read float (%f) values!
     */
    int parsed = sscanf(packet,
        "@TIME=%2hhd:%2hhd:%2hhd|DATE=%2hhd-%2hhd-%2hhd|CUR=%f|AVG=%f|FIRE=%hhd|LOCK=%hhd|TARG=%f",
        &latest_factory_data.time_hh,
        &latest_factory_data.time_mm,
        &latest_factory_data.time_ss,
        &latest_factory_data.date_yy,
        &latest_factory_data.date_mm,
        &latest_factory_data.date_dd,
        &latest_factory_data.current_temp,
        &latest_factory_data.avg_temp,
        &latest_factory_data.fire_triggered,
        &latest_factory_data.system_locked,
        &latest_factory_data.target_temp
    );

    if (parsed == 11) {
        // Successfully parsed all 11 variables!
        // You can trigger display updates or warning LEDs here.
    }
}
