                     "Selection: ",
                     remote_temp, remote_avg, remote_fire,
                     (strcmp(remote_lock, "1") == 0) ? "!!! LOCKED OUT !!!" : "NORMAL OPERATION");
            break;

        case HUB_STATE_ADMIN_AUTH:
            snprintf(menuBuffer, sizeof(menuBuffer),
                     "=========================================\r\n"
                     "        SECURE HUB AUTHENTICATION        \r\n"
                     "=========================================\r\n"
                     " Please enter Admin Password:\r\n"
                     " (Or type '0' to abort selection)\r\n"
                     "=========================================\r\n"
                     "Password: ");
            break;

        case HUB_STATE_ADMIN_MENU:
            snprintf(menuBuffer, sizeof(menuBuffer),
                     "=========================================\r\n"
                     "       HUB ADMINISTRATIVE COMMANDS       \r\n"
                     "=========================================\r\n"
                     " Available Actions:\r\n"
                     "  > Type 'clear_logs' - Reset local structures\r\n"
                     "  > Type '0'          - Relock and logout\r\n"
                     "=========================================\r\n"
                     "Command: ");
            break;
