/* USER CODE BEGIN 4 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        if (rxByte == '\r' || rxByte == '\n')
        {
            if (rxIndex > 0)
            {
                rxBuffer[rxIndex] = '\0';

                // Check packet network headers:
                if (rxBuffer[0] == '@')
                {
                    // Data is text message sent from U1
                    strncpy(messageFromBoard1, &rxBuffer[1], sizeof(messageFromBoard1) - 1);
                    rxIndex = 0;
                    memset(rxBuffer, 0, sizeof(rxBuffer));
                }
                else if (strncmp(rxBuffer, "ADC = ", 6) == 0)
                {
                    // Data is raw streaming ADC update packet from standard U1 updates
                    strncpy(sharedAdcValue, &rxBuffer[6], sizeof(sharedAdcValue) - 1);
                    rxIndex = 0;
                    memset(rxBuffer, 0, sizeof(rxBuffer));
                }
                else
                {
                    // Standard user data entry from local Virtual Terminal 2 typing console
                    lineReadyFromTerminal = 1;
                    return;
                }
            }
        }
        else if (rxIndex < sizeof(rxBuffer) - 1)
        {
            rxBuffer[rxIndex++] = (char)rxByte;
        }

        HAL_UART_Receive_IT(&huart1, &rxByte, 1);
    }
}
